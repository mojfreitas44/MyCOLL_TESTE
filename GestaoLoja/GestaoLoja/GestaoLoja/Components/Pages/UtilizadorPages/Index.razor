@page "/utilizadores"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using GestaoLoja.Data
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims

@attribute [Authorize(Roles = "Administrador,Funcionario")]

@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<IdentityRole> RoleManager
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>Gestão de Utilizadores</PageTitle>

<h1>Utilizadores Registados</h1>

@if (!string.IsNullOrEmpty(mensagemSucesso))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @mensagemSucesso
        <button type="button" class="btn-close" @onclick="() => mensagemSucesso = null"></button>
    </div>
}

@if (listaUtilizadores == null)
{
    <p><em>A carregar...</em></p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Email</th>
                <th>Nome</th>
                <th>Perfil (Role)</th>
                <th>Estado</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in listaUtilizadores)
            {
                // Ignorar o próprio utilizador (Regra: Não pode gerir o seu próprio registo)
                if (user.Id == currentUserId) continue;

                var roleDoAlvo = userRoles.ContainsKey(user.Id) && userRoles[user.Id].Any()
                ? userRoles[user.Id].First()
                : "Sem Role";

                <tr>
                    <td>@user.Email</td>
                    <td>@user.Nome</td>
                    <td>
                        @* LÓGICA DE PERMISSÃO PARA MUDAR ROLES *@
                        @if (PodeGerirRole(roleDoAlvo))
                        {
                            <select class="form-select form-select-sm"
                                    value="@roleDoAlvo"
                                    @onchange="@(e => AlterarRole(user, e.Value?.ToString()))">
                                @foreach (var r in todasRoles)
                                {
                                    // Funcionário não pode atribuir role de Admin ou Funcionário
                                    if (!euSouAdmin && (r == "Administrador" || r == "Funcionario")) continue;

                                    <option value="@r">@r</option>
                                }
                            </select>
                        }
                        else
                        {
                            @* Apenas mostra o texto se não tiver permissão para mudar *@
                            <span class="badge bg-secondary">@roleDoAlvo</span>
                        }
                    </td>
                    <td>
                        <span class="badge @(user.Estado == "Ativo" ? "bg-success" : "bg-warning text-dark")">
                            @user.Estado
                        </span>
                    </td>
                    <td>
                        @* LÓGICA DE PERMISSÃO PARA MUDAR ESTADO *@
                        @if (PodeGerirEstado(roleDoAlvo))
                        {
                            @if (user.Estado != "Ativo")
                            {
                                <button class="btn btn-sm btn-success" @onclick='() => AlterarEstado(user, "Ativo")'>Ativar</button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-warning" @onclick='() => AlterarEstado(user, "Pendente")'>Suspender</button>
                            }
                        }
                        else
                        {
                            <span class="text-muted small">Sem permissão</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<ApplicationUser>? listaUtilizadores;
    private Dictionary<string, IList<string>> userRoles = new();
    private List<string> todasRoles = new();
    private string? mensagemSucesso;

    // Variáveis de controlo de permissões
    private string currentUserId = "";
    private bool euSouAdmin = false;

    protected override async Task OnInitializedAsync()
    {
        // 1. Obter quem sou eu
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userPrincipal = authState.User;

        currentUserId = userPrincipal.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";
        euSouAdmin = userPrincipal.IsInRole("Administrador");

        // 2. Carregar dados
        todasRoles = await RoleManager.Roles.Select(r => r.Name!).OrderBy(n => n).ToListAsync();
        await CarregarUtilizadores();
    }

    private async Task CarregarUtilizadores()
    {
        listaUtilizadores = await UserManager.Users.ToListAsync();
        userRoles.Clear();

        foreach (var user in listaUtilizadores)
        {
            var roles = await UserManager.GetRolesAsync(user);
            userRoles[user.Id] = roles;
        }
    }

    // --- REGRAS DE NEGÓCIO ---

    // Regra: Só Admin gere Funcionários. Admin/Func gerem Clientes/Fornecedores.
    private bool PodeGerirRole(string roleAlvo)
    {
        if (euSouAdmin) return true; // Admin pode tudo (menos a si mesmo, filtrado no foreach)

        // Se sou Funcionário, SÓ posso mexer em Cliente ou Fornecedor
        if (roleAlvo == "Cliente" || roleAlvo == "Fornecedor" || roleAlvo == "Sem Role") return true;

        return false; // Funcionário não mexe em Admin nem noutros Funcionários
    }

    private bool PodeGerirEstado(string roleAlvo)
    {
        // Mesma lógica: Funcionário não pode suspender o Admin!
        return PodeGerirRole(roleAlvo);
    }

    // --------------------------

    private async Task AlterarRole(ApplicationUser user, string? novaRole)
    {
        if (string.IsNullOrEmpty(novaRole)) return;

        // Segurança extra no backend
        if (!euSouAdmin && (novaRole == "Administrador" || novaRole == "Funcionario")) return;

        var rolesAtuais = await UserManager.GetRolesAsync(user);
        if (rolesAtuais.Any()) await UserManager.RemoveFromRolesAsync(user, rolesAtuais);

        await UserManager.AddToRoleAsync(user, novaRole);
        mensagemSucesso = $"Perfil alterado para {novaRole}.";
        await CarregarUtilizadores();
    }

    private async Task AlterarEstado(ApplicationUser user, string novoEstado)
    {
        var u = await UserManager.FindByIdAsync(user.Id);
        if (u != null)
        {
            u.Estado = novoEstado;
            await UserManager.UpdateAsync(u);
            await CarregarUtilizadores();
        }
    }
}