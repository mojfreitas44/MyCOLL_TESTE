@page "/utilizadores"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using GestaoLoja.Data
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims

@attribute [Authorize(Roles = "Administrador,Funcionario")]

@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<IdentityRole> RoleManager
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<PageTitle>Gestão de Utilizadores</PageTitle>

<h1>Utilizadores Registados</h1>

@if (!string.IsNullOrEmpty(mensagemSucesso))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @mensagemSucesso
        <button type="button" class="btn-close" @onclick="() => mensagemSucesso = null"></button>
    </div>
}

@* --- BARRA DE FILTROS --- *@
<div class="card p-3 mb-4 bg-light">
    <div class="row g-3 align-items-center">
        <div class="col-md-4">
            <input type="text" class="form-control" placeholder="Pesquisar Email..."
                   @bind="FiltroTexto" @bind:event="oninput" @onkeyup="CarregarUtilizadores" />
        </div>
        <div class="col-md-3">
            <select class="form-select" @bind="FiltroRole">
                <option value="">-- Todos os Perfis --</option>
                @foreach (var r in todasRoles)
                {
                    <option value="@r">@r</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <button class="btn btn-primary w-100" @onclick="CarregarUtilizadores">
                <i class="bi bi-search"></i> Filtrar
            </button>
        </div>
    </div>
</div>

@if (listaUtilizadores == null)
{
    <p><em>A carregar...</em></p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Email</th>
                <th>Perfil (Role)</th>
                <th>Estado</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in listaUtilizadores)
            {
                // 1. Regra: Não posso gerir-me a mim próprio
                if (user.Id == currentUserId) continue;

                var roleDoAlvo = userRoles.ContainsKey(user.Id) && userRoles[user.Id].Any()
                ? userRoles[user.Id].First()
                : "Sem Role";

                // 2. Regra: O Super Admin é intocável
                bool isSuperAdmin = user.Email == "admin@mycoll.pt";

                <tr>
                    <td>@user.Email</td>
                    <td>
                        @if (isSuperAdmin)
                        {
                            <span class="badge bg-danger">SUPER ADMIN</span>
                        }
                        else if (PodeGerirRole(roleDoAlvo))
                        {
                            <select class="form-select form-select-sm"
                                    value="@roleDoAlvo"
                                    @onchange="@(e => AlterarRole(user, e.Value?.ToString()))">
                                @foreach (var r in todasRoles)
                                {
                                    if (!euSouAdmin && (r == "Administrador" || r == "Funcionario")) continue;
                                    <option value="@r">@r</option>
                                }
                            </select>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@roleDoAlvo</span>
                        }
                    </td>
                    <td>
                        <span class="badge @(user.Estado == "Ativo" ? "bg-success" : "bg-warning text-dark")">
                            @user.Estado
                        </span>
                    </td>
                    <td>
                        @if (isSuperAdmin)
                        {
                            <span class="text-muted small"><i class="bi bi-lock-fill"></i> Protegido</span>
                        }
                        else if (PodeGerirEstado(roleDoAlvo))
                        {
                            @if (user.Estado != "Ativo")
                            {
                                <button class="btn btn-sm btn-success" @onclick='() => AlterarEstado(user, "Ativo")'>Ativar</button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-warning" @onclick='() => AlterarEstado(user, "Pendente")'>Suspender</button>
                            }

                            <button class="btn btn-sm btn-outline-danger ms-1" @onclick='() => ApagarUtilizador(user)'>
                                <i class="bi bi-trash"></i> Apagar
                            </button>
                        }
                        else
                        {
                            <span class="text-muted small">Sem permissão</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex justify-content-center">
        <button class="btn btn-outline-primary me-2" @onclick="PaginaAnterior" disabled="@(PaginaAtual == 1)">Anterior</button>
        <span class="align-self-center">Página @PaginaAtual</span>
        <button class="btn btn-outline-primary ms-2" @onclick="ProximaPagina" disabled="@(!TemMaisPaginas)">Seguinte</button>
    </div>
}

@code {
    private List<ApplicationUser>? listaUtilizadores;
    private Dictionary<string, IList<string>> userRoles = new();
    private List<string> todasRoles = new();
    private string? mensagemSucesso;
    private string currentUserId = "";
    private bool euSouAdmin = false;

    // Filtros e Paginação
    private string FiltroTexto = "";
    private string FiltroRole = "";
    private int PaginaAtual = 1;
    private const int TamanhoPagina = 10;
    private bool TemMaisPaginas = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userDb = await UserManager.GetUserAsync(authState.User);
        if (userDb == null || userDb.Estado != "Ativo")
        {
            NavigationManager.NavigateTo("Account/AccessDenied");
            return;
        }

        currentUserId = userDb.Id;
        euSouAdmin = await UserManager.IsInRoleAsync(userDb, "Administrador");
        todasRoles = await RoleManager.Roles.Select(r => r.Name!).OrderBy(n => n).ToListAsync();

        await CarregarUtilizadores();
    }

    private async Task CarregarUtilizadores()
    {
        var query = UserManager.Users.AsQueryable();

        if (!string.IsNullOrEmpty(FiltroTexto))
        {
            // Filtra apenas por Email
            query = query.Where(u => u.Email!.Contains(FiltroTexto));
        }

        // Carrega utilizadores para filtrar por Role em memória
        var usersTemp = await query.ToListAsync();

        userRoles.Clear();
        var usersFiltrados = new List<ApplicationUser>();

        foreach (var user in usersTemp)
        {
            var roles = await UserManager.GetRolesAsync(user);
            var rolePrincipal = roles.FirstOrDefault() ?? "Sem Role";

            if (string.IsNullOrEmpty(FiltroRole) || rolePrincipal == FiltroRole)
            {
                userRoles[user.Id] = roles;
                usersFiltrados.Add(user);
            }
        }

        var total = usersFiltrados.Count;
        listaUtilizadores = usersFiltrados
            .Skip((PaginaAtual - 1) * TamanhoPagina)
            .Take(TamanhoPagina)
            .ToList();

        TemMaisPaginas = (PaginaAtual * TamanhoPagina) < total;
    }

    private async Task PaginaAnterior()
    {
        if (PaginaAtual > 1) { PaginaAtual--; await CarregarUtilizadores(); }
    }

    private async Task ProximaPagina()
    {
        if (TemMaisPaginas) { PaginaAtual++; await CarregarUtilizadores(); }
    }

    private bool PodeGerirRole(string roleAlvo)
    {
        if (euSouAdmin) return true;
        if (roleAlvo == "Cliente" || roleAlvo == "Fornecedor" || roleAlvo == "Sem Role") return true;
        return false;
    }

    private bool PodeGerirEstado(string roleAlvo) => PodeGerirRole(roleAlvo);

    private async Task AlterarRole(ApplicationUser user, string? novaRole)
    {
        if (string.IsNullOrEmpty(novaRole)) return;
        if (user.Email == "admin@mycoll.pt") return;

        if (!euSouAdmin && (novaRole == "Administrador" || novaRole == "Funcionario")) return;

        var rolesAtuais = await UserManager.GetRolesAsync(user);
        if (rolesAtuais.Any()) await UserManager.RemoveFromRolesAsync(user, rolesAtuais);

        await UserManager.AddToRoleAsync(user, novaRole);
        mensagemSucesso = $"Perfil de {user.Email} alterado para {novaRole}.";
        await CarregarUtilizadores();
    }

    private async Task AlterarEstado(ApplicationUser user, string novoEstado)
    {
        if (user.Email == "admin@mycoll.pt") return;
        user.Estado = novoEstado;
        await UserManager.UpdateAsync(user);
        await CarregarUtilizadores();
    }

    private async Task ApagarUtilizador(ApplicationUser user)
    {
        if (user.Email == "admin@mycoll.pt") return;
        bool confirmacao = await JSRuntime.InvokeAsync<bool>("confirm", $"Deseja mesmo apagar {user.Email}?");
        if (confirmacao)
        {
            await UserManager.DeleteAsync(user);
            mensagemSucesso = $"Utilizador {user.Email} foi apagado.";
            await CarregarUtilizadores();
        }
    }
}