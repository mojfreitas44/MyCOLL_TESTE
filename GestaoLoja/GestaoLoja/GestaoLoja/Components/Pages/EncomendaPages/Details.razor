@page "/encomendas/details"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using GestaoLoja.Data
@using GestaoLoja.Entities
@using Microsoft.AspNetCore.Identity

@rendermode InteractiveServer

@attribute [Authorize(Roles = "Administrador,Funcionario")]

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Detalhes da Encomenda</PageTitle>

@if (encomenda is null)
{
    <p><em>A carregar...</em></p>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Encomenda #@encomenda.Id</h1>
        <a href="encomendas" class="btn btn-outline-secondary">Voltar</a>
    </div>

    @* --- GESTÃO DE ESTADO (SINCRONIZADA COM O INDEX) --- *@
    <div class="card mb-4 border-primary shadow-sm">
        <div class="card-header bg-primary text-white fw-bold">
            <i class="bi bi-gear-fill me-2"></i>Gestão de Estado
        </div>
        <div class="card-body d-flex align-items-center justify-content-between flex-wrap gap-2">

            <div>
                <span class="text-muted me-2">Estado Atual:</span>
                <span class="badge fs-5 @GetBadge(encomenda.Estado)">@encomenda.Estado</span>
            </div>

            <div>
                @if (encomenda.Estado == "Pendente")
                {
                    <button class="btn btn-success" @onclick='() => MudarEstado("Pago")'>
                        <i class="bi bi-currency-dollar"></i> Confirmar Pagamento
                    </button>
                }
                else if (encomenda.Estado == "Pago")
                {
                    <button class="btn btn-warning text-dark" @onclick='() => MudarEstado("Enviado")'>
                        <i class="bi bi-box-seam"></i> Enviar Stock (Marcar Enviado)
                    </button>
                }
                else if (encomenda.Estado == "Enviado")
                {
                    <div class="alert alert-info mb-0 py-2 px-3">
                        <i class="bi bi-hourglass-split me-2"></i>
                        A aguardar confirmação de receção pelo cliente...
                    </div>
                }
                else if (encomenda.Estado == "Entregue")
                {
                    <span class="text-success me-3 fw-bold">
                        <i class="bi bi-check-circle-fill"></i> O Cliente confirmou a receção!
                    </span>
                    <button class="btn btn-primary" @onclick='() => MudarEstado("Concluido")'>
                        <i class="bi bi-archive-fill"></i> Concluir Encomenda
                    </button>
                }
                else if (encomenda.Estado == "Concluido")
                {
                    <span class="text-success fw-bold border border-success rounded px-3 py-2">
                        <i class="bi bi-lock-fill"></i> Processo Fechado
                    </span>
                }
            </div>
        </div>
    </div>
    @* ------------------------------------------------ *@

    <div class="row">
        @* Dados do Cliente *@
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header fw-bold">Informação de Envio</div>
                <div class="card-body">
                    <p><strong>Cliente:</strong> @(encomenda.Cliente?.Nome ?? encomenda.Cliente?.Email)</p>
                    <p><strong>Email:</strong> @encomenda.Cliente?.Email</p>
                    <p><strong>Morada:</strong> @(encomenda.MoradaEnvio ?? "N/A")</p>
                    <p><strong>Método Entrega:</strong> @encomenda.MetodoEntrega</p>
                </div>
            </div>
        </div>

        @* Resumo Financeiro *@
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header fw-bold">Detalhes Financeiros</div>
                <div class="card-body">
                    <p><strong>Data:</strong> @encomenda.Data</p>
                    <p><strong>Método Pagamento:</strong> @encomenda.MetodoPagamento</p>

                    <hr />

                    @{
                        decimal totalProdutos = encomenda.Itens.Sum(i => i.PrecoUnitario * i.Quantidade);
                        decimal valorEnvio = encomenda.ValorTotal - totalProdutos;
                    }

                    <div class="d-flex justify-content-between">
                        <span>Subtotal Produtos:</span>
                        <span>@totalProdutos.ToString("C")</span>
                    </div>

                    <div class="d-flex justify-content-between text-muted">
                        <span>Envio (@(encomenda.MetodoEntrega ?? "N/A")):</span>
                        <span>@valorEnvio.ToString("C")</span>
                    </div>

                    <div class="d-flex justify-content-between mt-3 border-top pt-2">
                        <h4 class="fw-bold">Total:</h4>
                        <h4 class="fw-bold text-success">@encomenda.ValorTotal.ToString("C")</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Lista de Produtos *@
    <h3>Itens da Encomenda</h3>
    <table class="table table-bordered table-striped">
        <thead class="table-light">
            <tr>
                <th>Produto</th>
                <th>Preço Unit.</th>
                <th>Qtd</th>
                <th>Subtotal</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in encomenda.Itens)
            {
                <tr>
                    <td>@item.Produto?.Nome</td>
                    <td>@item.PrecoUnitario.ToString("C")</td>
                    <td>@item.Quantidade</td>
                    <td>@((item.PrecoUnitario * item.Quantidade).ToString("C"))</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [SupplyParameterFromQuery]
    public int Id { get; set; }

    private Encomenda? encomenda;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userDb = await UserManager.GetUserAsync(authState.User);
        if (userDb == null || userDb.Estado != "Ativo")
        {
            NavigationManager.NavigateTo("Account/AccessDenied");
            return;
        }

        using var context = DbFactory.CreateDbContext();
        encomenda = await context.Encomendas
            .Include(e => e.Cliente)
            .Include(e => e.Itens)
            .ThenInclude(i => i.Produto)
            .FirstOrDefaultAsync(m => m.Id == Id);

        if (encomenda is null)
        {
            NavigationManager.NavigateTo("encomendas");
        }
    }

    private async Task MudarEstado(string novoEstado)
    {
        if (encomenda == null) return;

        using var context = DbFactory.CreateDbContext();
        var encomendaDb = await context.Encomendas.FindAsync(encomenda.Id);

        if (encomendaDb != null)
        {
            encomendaDb.Estado = novoEstado;
            await context.SaveChangesAsync();
            encomenda.Estado = novoEstado; // Atualiza UI Local
        }
    }

    private string GetBadge(string estado) => estado switch
    {
        "Pendente" => "bg-danger",
        "Pago" => "bg-warning text-dark",
        "Enviado" => "bg-info text-dark",
        "Entregue" => "bg-primary",
        "Concluido" => "bg-success",
        _ => "bg-secondary"
    };
}