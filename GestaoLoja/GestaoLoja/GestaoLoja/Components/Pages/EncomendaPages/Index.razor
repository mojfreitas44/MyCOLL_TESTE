@page "/encomendas"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using GestaoLoja.Data
@using GestaoLoja.Entities
@using Microsoft.AspNetCore.Identity
@using Microsoft.JSInterop

@attribute [Authorize(Roles = "Administrador,Funcionario")]

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Gestão de Encomendas</PageTitle>

<h1>Encomendas</h1>

<div class="card p-3 mb-4 bg-light">
    <div class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label fw-bold">Data Início</label>
            <input type="date" class="form-control" @bind="FiltroDataInicio" />
        </div>
        <div class="col-md-3">
            <label class="form-label fw-bold">Data Fim</label>
            <input type="date" class="form-control" @bind="FiltroDataFim" />
        </div>
        <div class="col-md-3">
            <label class="form-label fw-bold">Estado</label>
            <select class="form-select" @bind="FiltroEstado">
                <option value="Todos">Todos</option>
                <option value="Pendente">Pendente</option>
                <option value="Pago">Pago</option>
                <option value="Enviado">Enviado</option>
                <option value="Entregue">Entregue (A fechar)</option>
                <option value="Concluido">Concluído</option>
            </select>
        </div>
        <div class="col-md-3">
            <button class="btn btn-primary w-100" @onclick="AplicarFiltros">
                <i class="bi bi-search"></i> Filtrar
            </button>
        </div>
    </div>
</div>

@if (encomendas == null)
{
    <p><em>A carregar...</em></p>
}
else if (!encomendas.Any())
{
    <div class="alert alert-info">Não foram encontradas encomendas com estes filtros.</div>
}
else
{
    <table class="table table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Data</th>
                <th>Cliente</th>
                <th>Total</th>
                <th>Estado</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var enc in encomendas)
            {
                <tr>
                    <td>@enc.Id</td>
                    <td>@enc.Data.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        @(enc.Cliente?.Nome ?? enc.Cliente?.UserName ?? "Anónimo")
                    </td>
                    <td>@enc.ValorTotal.ToString("C")</td>
                    <td>
                        <span class="badge @GetBadge(enc.Estado)">@enc.Estado</span>
                    </td>
                    <td>
                        <a href="encomendas/details?id=@enc.Id" class="btn btn-sm btn-outline-info">
                            Detalhes
                        </a>

                        @* LÓGICA RIGOROSA DE ESTADOS *@
                        @if (enc.Estado == "Pendente")
                        {
                            <button class="btn btn-sm btn-success ms-1" @onclick='() => MudarEstado(enc, "Pago")'>Marcar Pago</button>
                        }
                        else if (enc.Estado == "Pago")
                        {
                            <button class="btn btn-sm btn-warning ms-1" @onclick='() => MudarEstado(enc, "Enviado")'>Enviar (Stock)</button>
                        }
                        else if (enc.Estado == "Enviado")
                        {
                            @* AQUI: Não mostra botão, apenas aviso *@
                            <span class="ms-2 small text-muted fst-italic"><i class="bi bi-hourglass-split"></i> Aguarda Cliente</span>
                        }
                        else if (enc.Estado == "Entregue")
                        {
                            @* AQUI: Só aparece quando o cliente já confirmou *@
                            <button class="btn btn-sm btn-primary ms-1" @onclick='() => MudarEstado(enc, "Concluido")'>Concluir</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @* --- PAGINAÇÃO --- *@
    <div class="d-flex justify-content-center mt-3">
        <button class="btn btn-outline-primary me-2" @onclick="PaginaAnterior" disabled="@(PaginaAtual == 1)">Anterior</button>
        <span class="align-self-center">Página @PaginaAtual de @TotalPaginas</span>
        <button class="btn btn-outline-primary ms-2" @onclick="ProximaPagina" disabled="@(PaginaAtual >= TotalPaginas)">Seguinte</button>
    </div>
}

@code {
    private List<Encomenda>? encomendas;

    // Filtros
    private DateTime? FiltroDataInicio;
    private DateTime? FiltroDataFim;
    private string FiltroEstado = "Todos";

    // Paginação
    private int PaginaAtual = 1;
    private const int TamanhoPagina = 10;
    private int TotalItens = 0;
    private int TotalPaginas => TotalItens == 0 ? 1 : (int)Math.Ceiling((double)TotalItens / TamanhoPagina);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userDb = await UserManager.GetUserAsync(authState.User);
        if (userDb == null || userDb.Estado != "Ativo")
        {
            NavigationManager.NavigateTo("Account/AccessDenied");
            return;
        }
        await CarregarDados();
    }

    private async Task AplicarFiltros()
    {
        PaginaAtual = 1; // Reset da página ao filtrar
        await CarregarDados();
    }

    private async Task CarregarDados()
    {
        using var context = DbFactory.CreateDbContext();
        var query = context.Encomendas
            .Include(e => e.Cliente)
            .AsQueryable();

        if (FiltroEstado != "Todos")
        {
            query = query.Where(e => e.Estado == FiltroEstado);
        }

        if (FiltroDataInicio.HasValue)
        {
            query = query.Where(e => e.Data >= FiltroDataInicio.Value);
        }
        if (FiltroDataFim.HasValue)
        {
            var dataFim = FiltroDataFim.Value.AddDays(1);
            query = query.Where(e => e.Data < dataFim);
        }

        // 1. Contar
        TotalItens = await query.CountAsync();

        // 2. Buscar Página
        encomendas = await query
            .OrderByDescending(e => e.Data)
            .Skip((PaginaAtual - 1) * TamanhoPagina)
            .Take(TamanhoPagina)
            .ToListAsync();
    }

    private async Task PaginaAnterior()
    {
        if (PaginaAtual > 1)
        {
            PaginaAtual--;
            await CarregarDados();
        }
    }

    private async Task ProximaPagina()
    {
        if (PaginaAtual < TotalPaginas)
        {
            PaginaAtual++;
            await CarregarDados();
        }
    }

    private async Task MudarEstado(Encomenda enc, string novoEstado)
    {
        using var context = DbFactory.CreateDbContext();
        var encomendaDb = await context.Encomendas.FirstOrDefaultAsync(e => e.Id == enc.Id);

        if (encomendaDb != null)
        {
            encomendaDb.Estado = novoEstado;
            await context.SaveChangesAsync();
            await CarregarDados(); // Recarregar tabela
        }
    }

    private string GetBadge(string estado) => estado switch
    {
        "Pendente" => "bg-danger",
        "Pago" => "bg-warning text-dark",
        "Enviado" => "bg-info text-dark",
        "Entregue" => "bg-primary",
        "Concluido" => "bg-success",
        _ => "bg-secondary"
    };
}