@page "/encomendas"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using GestaoLoja.Data
@using GestaoLoja.Entities
@using Microsoft.AspNetCore.Identity
@using Microsoft.JSInterop

@attribute [Authorize(Roles = "Administrador,Funcionario")]

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Gestão de Encomendas</PageTitle>

<h1>Encomendas</h1>

@* --- BARRA DE FILTROS (Ponto 2) --- *@
<div class="card p-3 mb-4 bg-light">
    <div class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label fw-bold">Data Início</label>
            <input type="date" class="form-control" @bind="FiltroDataInicio" />
        </div>
        <div class="col-md-3">
            <label class="form-label fw-bold">Data Fim</label>
            <input type="date" class="form-control" @bind="FiltroDataFim" />
        </div>
        <div class="col-md-3">
            <label class="form-label fw-bold">Estado</label>
            <select class="form-select" @bind="FiltroEstado">
                <option value="Todos">Todos</option>
                <option value="Pendente">Pendente</option>
                <option value="Pago">Pago</option>
                <option value="Enviado">Enviado</option>
                <option value="Concluido">Concluído</option>
            </select>
        </div>
        <div class="col-md-3">
            <button class="btn btn-primary w-100" @onclick="CarregarDados">
                <i class="bi bi-search"></i> Filtrar
            </button>
        </div>
    </div>
</div>

@if (encomendas == null)
{
    <p><em>A carregar...</em></p>
}
else if (!encomendas.Any())
{
    <div class="alert alert-info">Não foram encontradas encomendas com estes filtros.</div>
}
else
{
    <table class="table table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Data</th>
                <th>Cliente</th>
                <th>Total</th>
                <th>Estado</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var enc in encomendas)
            {
                <tr>
                    <td>@enc.Id</td>
                    <td>@enc.Data.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        @(enc.Cliente?.Nome ?? enc.Cliente?.UserName ?? "Anónimo")
                    </td>
                    <td>@enc.ValorTotal.ToString("C")</td>
                    <td>
                        <span class="badge @GetBadge(enc.Estado)">@enc.Estado</span>
                    </td>
                    <td>
                        <a href="encomendas/details?id=@enc.Id" class="btn btn-sm btn-outline-info">
                            Detalhes
                        </a>

                        @* Botões de alteração de estado *@
                        @if (enc.Estado == "Pendente")
                        {
                            <button class="btn btn-sm btn-success ms-1" @onclick='() => MudarEstado(enc, "Pago")'>Marcar Pago</button>
                        }
                        else if (enc.Estado == "Pago")
                        {
                            <button class="btn btn-sm btn-warning ms-1" @onclick='() => MudarEstado(enc, "Enviado")'>Enviar (Stock)</button>
                        }
                        else if (enc.Estado == "Enviado")
                        {
                            <button class="btn btn-sm btn-secondary ms-1" @onclick='() => MudarEstado(enc, "Concluido")'>Concluir</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Encomenda>? encomendas;

    // Variáveis para os Filtros
    private DateTime? FiltroDataInicio;
    private DateTime? FiltroDataFim;
    private string FiltroEstado = "Todos";

    protected override async Task OnInitializedAsync()
    {
        // Segurança
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userDb = await UserManager.GetUserAsync(authState.User);
        if (userDb == null || userDb.Estado != "Ativo")
        {
            NavigationManager.NavigateTo("Account/AccessDenied");
            return;
        }

        await CarregarDados();
    }

    private async Task CarregarDados()
    {
        using var context = DbFactory.CreateDbContext();

        // Query Base
        var query = context.Encomendas
            .Include(e => e.Cliente)
            .AsQueryable();

        // Aplicar Filtro de Estado
        if (FiltroEstado != "Todos")
        {
            query = query.Where(e => e.Estado == FiltroEstado);
        }

        // Aplicar Filtro de Datas
        if (FiltroDataInicio.HasValue)
        {
            query = query.Where(e => e.Data >= FiltroDataInicio.Value);
        }
        if (FiltroDataFim.HasValue)
        {
            // Adiciona 1 dia para incluir o próprio dia selecionado (até às 23:59)
            var dataFim = FiltroDataFim.Value.AddDays(1);
            query = query.Where(e => e.Data < dataFim);
        }

        encomendas = await query.OrderByDescending(e => e.Data).ToListAsync();
    }

    // --- LÓGICA DE ATUALIZAÇÃO DE STOCK (Ponto 1) ---
    private async Task MudarEstado(Encomenda enc, string novoEstado)
    {
        using var context = DbFactory.CreateDbContext();

        // Carregar a encomenda COM os itens e os produtos para mexer no stock
        var encomendaDb = await context.Encomendas
            .Include(e => e.Itens)
            .ThenInclude(i => i.Produto)
            .FirstOrDefaultAsync(e => e.Id == enc.Id);

        if (encomendaDb != null)
        {
            // Se estamos a enviar, vamos descontar o stock
            if (novoEstado == "Enviado" && encomendaDb.Estado != "Enviado" && encomendaDb.Estado != "Concluido")
            {
                // 1. Validação: Verificar se há stock suficiente para todos os itens
                foreach (var item in encomendaDb.Itens)
                {
                    if (item.Produto.Stock < item.Quantidade)
                    {
                        await JS.InvokeVoidAsync("alert", $"Erro: Stock insuficiente para o produto '{item.Produto.Nome}'. Stock atual: {item.Produto.Stock}, Necessário: {item.Quantidade}.");
                        return; // Cancela a operação
                    }
                }

                // 2. Execução: Descontar stock
                foreach (var item in encomendaDb.Itens)
                {
                    item.Produto.Stock -= item.Quantidade;
                    // Opcional: Verificar se stock ficou a 0 e mudar estado do produto?
                    // Para já, apenas subtrai.
                }
            }

            encomendaDb.Estado = novoEstado;
            await context.SaveChangesAsync();

            // Recarregar lista para atualizar UI
            await CarregarDados();
        }
    }

    private string GetBadge(string estado) => estado switch
    {
        "Pendente" => "bg-danger",
        "Pago" => "bg-warning text-dark",
        "Enviado" => "bg-primary",
        "Concluido" => "bg-success",
        _ => "bg-secondary"
    };
}