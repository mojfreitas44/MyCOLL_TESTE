@page "/sobre"
@using GestaoLoja

<PageTitle>Sobre Nós - @AppConfig.NomeLoja</PageTitle>

<div class="container mt-4">
    <div class="row align-items-center">
        <div class="col-md-6">
            <h1 class="fw-bold text-primary mb-4">Sobre a @AppConfig.NomeLoja</h1>
            <p class="lead text-muted">
                Dedicamo-nos a conectar entusiastas e preservar a história através de colecionáveis únicos.
            </p>

            <div class="card shadow-sm border-0 mt-4 bg-light">
                <div class="card-body p-4">
                    <h4 class="mb-3"><i class="bi bi-geo-alt-fill text-danger me-2"></i>Onde Estamos</h4>
                    <p class="mb-1 fw-bold">@AppConfig.NomeLoja</p>

                    @* --- AQUI: style="white-space: pre-line" para respeitar os Enters --- *@
                    <p class="mb-4" style="white-space: pre-line">@AppConfig.Morada</p>

                    <h4 class="mb-3"><i class="bi bi-telephone-fill text-success me-2"></i>Contactos</h4>
                    <p class="mb-1">
                        <strong>Email:</strong>
                        <a href="mailto:@AppConfig.Email" class="text-decoration-none">@AppConfig.Email</a>
                    </p>
                    <p class="mb-0">
                        <strong>Telefone:</strong> @AppConfig.Telefone
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-6 mt-4 mt-md-0">
            <img src="https://images.unsplash.com/photo-1497366216548-37526070297c?q=80&w=1000&auto=format&fit=crop"
                 class="img-fluid rounded-3 shadow"
                 alt="Escritório" />
        </div>
    </div>
</div>