@page "/categorias/delete"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using GestaoLoja.Data
@using GestaoLoja.Entities
@using Microsoft.AspNetCore.Identity

@attribute [Authorize(Roles = "Administrador,Funcionario")]

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>Apagar Categoria</PageTitle>

<h1>Apagar Categoria</h1>

<h3>Tem a certeza que deseja apagar isto?</h3>

@if (mensagemErro != null)
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @mensagemErro
    </div>
}

@if (categoria is null)
{
    <p><em>A carregar...</em></p>
}
else
{
    <div>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">Nome</dt>
            <dd class="col-sm-10">@categoria.Nome</dd>
            <dt class="col-sm-2">Descrição</dt>
            <dd class="col-sm-10">@categoria.Descricao</dd>
        </dl>

        <div class="mt-3">
            @if (!podeApagar)
            {
                <button class="btn btn-danger" disabled>Apagar (Bloqueado)</button>
            }
            else
            {
                <button class="btn btn-danger" @onclick="ApagarCategoria">Apagar</button>
            }
            <a href="categorias" class="btn btn-secondary">Cancelar</a>
        </div>
    </div>
}

@code {
    private Categoria? categoria;
    private string? mensagemErro;
    private bool podeApagar = true;

    [SupplyParameterFromQuery]
    public int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // --- SEGURANÇA ---
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userDb = await UserManager.GetUserAsync(authState.User);
        if (userDb == null || userDb.Estado != "Ativo")
        {
            NavigationManager.NavigateTo("Account/AccessDenied");
            return;
        }
        // -----------------

        using var context = DbFactory.CreateDbContext();
        categoria = await context.Categorias.FirstOrDefaultAsync(m => m.Id == Id);

        if (categoria is null)
        {
            NavigationManager.NavigateTo("categorias");
            return;
        }

        // VERIFICAÇÃO PRÉVIA: Tem produtos?
        var temProdutos = await context.Produtos.AnyAsync(p => p.CategoriaId == Id);
        var temSubcategorias = await context.Categorias.AnyAsync(c => c.CategoriaPaiId == Id);

        if (temProdutos)
        {
            mensagemErro = "Não é possível apagar: Existem produtos associados a esta categoria.";
            podeApagar = false;
        }
        else if (temSubcategorias)
        {
            mensagemErro = "Não é possível apagar: Existem sub-categorias que dependem desta.";
            podeApagar = false;
        }
    }

    private async Task ApagarCategoria()
    {
        using var context = DbFactory.CreateDbContext();
        try
        {
            // Re-verificar no momento do click (para segurança em concorrência)
            var temProdutos = await context.Produtos.AnyAsync(p => p.CategoriaId == Id);
            if (temProdutos)
            {
                mensagemErro = "Erro: Foram adicionados produtos entretanto. Não pode apagar.";
                return;
            }

            // Anexar e apagar
            context.Categorias.Remove(categoria!);
            await context.SaveChangesAsync();
            NavigationManager.NavigateTo("categorias");
        }
        catch (Exception ex)
        {
            mensagemErro = "Erro ao apagar na base de dados: " + ex.Message;
        }
    }
}