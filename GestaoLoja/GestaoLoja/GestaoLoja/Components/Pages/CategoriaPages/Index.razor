@page "/categorias"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using GestaoLoja.Data
@using GestaoLoja.Entities
@using Microsoft.AspNetCore.Identity
@using System.Security.Claims

@attribute [Authorize(Roles = "Administrador,Funcionario")]

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Categorias</PageTitle>

<h1>Gestão de Categorias</h1>

<p>
    <a href="categorias/create" class="btn btn-primary">Nova Categoria</a>
</p>

@if (categorias == null)
{
    <p><em>A carregar...</em></p>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Categoria Pai</th>
                <th>Descrição</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in categorias)
            {
                <tr>
                    <td>@item.Nome</td>
                    <td>
                        @if (item.CategoriaPai != null)
                        {
                            <span class="badge bg-secondary">@item.CategoriaPai.Nome</span>
                        }
                        else
                        {
                            <span class="text-muted small">- Raiz -</span>
                        }
                    </td>
                    <td>@item.Descricao</td>
                    <td>
                        <a href="categorias/edit?id=@item.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                        <a href="categorias/delete?id=@item.Id" class="btn btn-sm btn-outline-danger">Apagar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Categoria>? categorias;

    protected override async Task OnInitializedAsync()
    {
        // --- SEGURANÇA: Verificar se está ATIVO ---
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userDb = await UserManager.GetUserAsync(authState.User);
        if (userDb == null || userDb.Estado != "Ativo")
        {
            NavigationManager.NavigateTo("Account/AccessDenied");
            return;
        }
        // ------------------------------------------

        using var context = DbFactory.CreateDbContext();
        categorias = await context.Categorias
            .Include(c => c.CategoriaPai)
            .OrderBy(c => c.CategoriaPaiId)
            .ThenBy(c => c.Nome)
            .ToListAsync();
    }
}