@page "/categorias"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using GestaoLoja.Data
@using GestaoLoja.Entities
@using Microsoft.AspNetCore.Identity
@using System.Security.Claims

@attribute [Authorize(Roles = "Administrador,Funcionario")]

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Categorias</PageTitle>

<h1>Gestão de Categorias</h1>

<p>
    <a href="categorias/create" class="btn btn-primary">Nova Categoria</a>
</p>

@if (categorias == null)
{
    <p><em>A carregar...</em></p>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Categoria Pai</th>
                <th>Descrição</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in categorias)
            {
                <tr>
                    <td>@item.Nome</td>
                    <td>
                        @if (item.CategoriaPai != null)
                        {
                            <span class="badge bg-secondary">@item.CategoriaPai.Nome</span>
                        }
                        else
                        {
                            <span class="text-muted small">- Raiz -</span>
                        }
                    </td>
                    <td>@item.Descricao</td>
                    <td>
                        <a href="categorias/edit?id=@item.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                        <a href="categorias/delete?id=@item.Id" class="btn btn-sm btn-outline-danger">Apagar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @* --- BOTÕES DE PAGINAÇÃO --- *@
    <div class="d-flex justify-content-center mt-3">
        <button class="btn btn-outline-primary me-2" @onclick="PaginaAnterior" disabled="@(PaginaAtual == 1)">Anterior</button>
        <span class="align-self-center">Página @PaginaAtual de @TotalPaginas</span>
        <button class="btn btn-outline-primary ms-2" @onclick="ProximaPagina" disabled="@(PaginaAtual >= TotalPaginas)">Seguinte</button>
    </div>
}

@code {
    private List<Categoria>? categorias;

    // Paginação
    private int PaginaAtual = 1;
    private const int TamanhoPagina = 10;
    private int TotalItens = 0;
    private int TotalPaginas => (int)Math.Ceiling((double)TotalItens / TamanhoPagina);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userDb = await UserManager.GetUserAsync(authState.User);
        if (userDb == null || userDb.Estado != "Ativo")
        {
            NavigationManager.NavigateTo("Account/AccessDenied");
            return;
        }

        await CarregarDados();
    }

    private async Task CarregarDados()
    {
        using var context = DbFactory.CreateDbContext();

        var query = context.Categorias
            .Include(c => c.CategoriaPai)
            .OrderBy(c => c.CategoriaPaiId)
            .ThenBy(c => c.Nome);

        // Contar total
        TotalItens = await query.CountAsync();

        // Buscar página
        categorias = await query
            .Skip((PaginaAtual - 1) * TamanhoPagina)
            .Take(TamanhoPagina)
            .ToListAsync();
    }

    private async Task PaginaAnterior()
    {
        if (PaginaAtual > 1)
        {
            PaginaAtual--;
            await CarregarDados();
        }
    }

    private async Task ProximaPagina()
    {
        if (PaginaAtual < TotalPaginas)
        {
            PaginaAtual++;
            await CarregarDados();
        }
    }
}