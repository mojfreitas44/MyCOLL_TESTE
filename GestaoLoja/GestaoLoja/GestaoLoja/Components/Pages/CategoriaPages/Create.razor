@page "/categorias/create"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using GestaoLoja.Data
@using GestaoLoja.Entities
@using Microsoft.AspNetCore.Identity

@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrador,Funcionario")]

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Nova Categoria</PageTitle>

<h1>Criar Categoria</h1>
<hr />

<div class="row">
    <div class="col-md-4">
        <EditForm Model="Categoria" OnValidSubmit="AdicionarCategoria" FormName="create_cat" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" />

            <div class="mb-3">
                <label for="nome" class="form-label">Nome</label>
                <InputText id="nome" @bind-Value="Categoria.Nome" class="form-control" />
                <ValidationMessage For="() => Categoria.Nome" class="text-danger" />
            </div>

            <div class="mb-3">
                <label for="descricao" class="form-label">Descrição</label>
                <InputTextArea id="descricao" @bind-Value="Categoria.Descricao" class="form-control" />
                <ValidationMessage For="() => Categoria.Descricao" class="text-danger" />
            </div>

            <div class="mb-3">
                <label class="form-label">Categoria Pai (Opcional)</label>
                <InputSelect @bind-Value="Categoria.CategoriaPaiId" class="form-select">
                    <option value="">-- Nenhuma (Categoria de Topo) --</option>
                    @foreach (var cat in listaCategorias)
                    {
                        <option value="@cat.Id">@cat.Nome</option>
                    }
                </InputSelect>
                <div class="form-text">Selecione apenas se esta for uma sub-categoria.</div>
            </div>

            <button type="submit" class="btn btn-primary">Salvar</button>
            <a href="categorias" class="btn btn-secondary">Cancelar</a>
        </EditForm>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    public Categoria Categoria { get; set; } = new();

    private List<Categoria> listaCategorias = new();

    protected override async Task OnInitializedAsync()
    {
        // --- SEGURANÇA ---
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userDb = await UserManager.GetUserAsync(authState.User);
        if (userDb == null || userDb.Estado != "Ativo")
        {
            NavigationManager.NavigateTo("Account/AccessDenied");
            return;
        }
        // -----------------

        using var context = DbFactory.CreateDbContext();
        listaCategorias = await context.Categorias.OrderBy(c => c.Nome).ToListAsync();
    }

    private async Task AdicionarCategoria()
    {
        using var context = DbFactory.CreateDbContext();
        context.Categorias.Add(Categoria);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("categorias");
    }
}