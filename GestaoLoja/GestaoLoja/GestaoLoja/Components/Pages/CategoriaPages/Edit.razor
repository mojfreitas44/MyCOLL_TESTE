@page "/categorias/edit"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using GestaoLoja.Data
@using GestaoLoja.Entities
@using Microsoft.AspNetCore.Identity

@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrador,Funcionario")]

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Editar Categoria</PageTitle>

<h1>Editar Categoria</h1>
<hr />

@if (Categoria is null)
{
    <p><em>A carregar...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm Model="Categoria" OnValidSubmit="AtualizarCategoria" FormName="edit_cat" method="post">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />
                <input type="hidden" name="Categoria.Id" value="@Categoria.Id" />

                <div class="mb-3">
                    <label for="nome" class="form-label">Nome</label>
                    <InputText id="nome" @bind-Value="Categoria.Nome" class="form-control" />
                    <ValidationMessage For="() => Categoria.Nome" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label for="descricao" class="form-label">Descrição</label>
                    <InputTextArea id="descricao" @bind-Value="Categoria.Descricao" class="form-control" />
                    <ValidationMessage For="() => Categoria.Descricao" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Categoria Pai</label>
                    @* O segredo para int? funcionar bem é tratar o valor vazio como null *@
                    <InputSelect @bind-Value="Categoria.CategoriaPaiId" class="form-select">
                        <option value="">-- Nenhuma (Topo) --</option>
                        @foreach (var cat in listaCategorias)
                        {
                            // Evita que uma categoria seja pai de si mesma (ciclo infinito)
                            if (cat.Id != Categoria.Id)
                            {
                                <option value="@cat.Id">@cat.Nome</option>
                            }
                        }
                    </InputSelect>
                </div>

                <button type="submit" class="btn btn-primary">Salvar</button>
                <a href="categorias" class="btn btn-secondary">Cancelar</a>
            </EditForm>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery]
    public int Id { get; set; }

    [SupplyParameterFromForm]
    public Categoria? Categoria { get; set; }

    private List<Categoria> listaCategorias = new();

    protected override async Task OnInitializedAsync()
    {
        // --- SEGURANÇA ---
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userDb = await UserManager.GetUserAsync(authState.User);
        if (userDb == null || userDb.Estado != "Ativo")
        {
            NavigationManager.NavigateTo("Account/AccessDenied");
            return;
        }
        // -----------------

        using var context = DbFactory.CreateDbContext();
        listaCategorias = await context.Categorias.OrderBy(c => c.Nome).ToListAsync();

        if (Categoria is null)
        {
            Categoria = await context.Categorias.FirstOrDefaultAsync(m => m.Id == Id);
            if (Categoria is null) NavigationManager.NavigateTo("categorias");
        }
    }

    private async Task AtualizarCategoria()
    {
        using var context = DbFactory.CreateDbContext();

        // 1. Buscar a versão ORIGINAL da base de dados
        var categoriaDb = await context.Categorias.FindAsync(Categoria!.Id);

        if (categoriaDb != null)
        {
            // 2. Copiar os valores novos para o objeto da BD
            categoriaDb.Nome = Categoria.Nome;
            categoriaDb.Descricao = Categoria.Descricao;
            categoriaDb.CategoriaPaiId = Categoria.CategoriaPaiId; // <--- AQUI É QUE A MAGIA ACONTECE

            // 3. Gravar
            await context.SaveChangesAsync();
        }

        NavigationManager.NavigateTo("categorias");
    }
}