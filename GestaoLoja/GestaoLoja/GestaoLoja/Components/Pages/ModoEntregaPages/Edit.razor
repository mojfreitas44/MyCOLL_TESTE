@page "/modosentrega/edit"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using GestaoLoja.Data
@using GestaoLoja.Entities

@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrador,Funcionario")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Editar Modo</PageTitle>

<h1>Editar Modo de Entrega</h1>
<hr />

@if (Modo is null)
{
    <p><em>A carregar...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm Model="Modo" OnValidSubmit="Salvar" FormName="edit_modo" method="post">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />
                <input type="hidden" name="Modo.Id" value="@Modo.Id" />

                <div class="mb-3">
                    <label class="form-label">Nome</label>
                    <InputText @bind-Value="Modo.Nome" class="form-control" />
                    <ValidationMessage For="() => Modo.Nome" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Descrição</label>
                    <InputTextArea @bind-Value="Modo.Descricao" class="form-control" />
                    <ValidationMessage For="() => Modo.Descricao" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Custo (€)</label>
                    <InputNumber @bind-Value="Modo.Preco" class="form-control" />
                    <ValidationMessage For="() => Modo.Preco" class="text-danger" />
                </div>

                <button type="submit" class="btn btn-primary">Guardar</button>
                <a href="modosentrega" class="btn btn-secondary">Cancelar</a>
            </EditForm>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery]
    public int Id { get; set; }

    [SupplyParameterFromForm]
    public ModoEntrega? Modo { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Só carrega da BD se não vier de um submit (se Modo for null)
        if (Modo is null)
        {
            using var context = DbFactory.CreateDbContext();
            Modo = await context.ModosEntrega.FirstOrDefaultAsync(m => m.Id == Id);

            if (Modo is null)
            {
                NavigationManager.NavigateTo("modosentrega");
            }
        }
    }

    private async Task Salvar()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(Modo!).State = EntityState.Modified;
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("modosentrega");
    }
}