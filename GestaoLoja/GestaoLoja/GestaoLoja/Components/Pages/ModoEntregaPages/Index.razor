@page "/modosentrega"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using GestaoLoja.Data
@using GestaoLoja.Entities
@using Microsoft.AspNetCore.Identity

@attribute [Authorize(Roles = "Administrador,Funcionario")]

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Modos de Entrega</PageTitle>

<h1>Modos de Disponibilização</h1>

<p>
    <a href="modosentrega/create" class="btn btn-primary">Novo Modo</a>
</p>

@if (modos == null)
{
    <p><em>A carregar...</em></p>
}
else if (modos.Count == 0)
{
    <p><em>Não existem modos de entrega configurados.</em></p>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Descrição</th>
                <th>Custo</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in modos)
            {
                <tr>
                    <td>@item.Nome</td>
                    <td>@item.Descricao</td>
                    <td>@item.Preco.ToString("C")</td>
                    <td>
                        <a href="modosentrega/edit?id=@item.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                        <a href="modosentrega/delete?id=@item.Id" class="btn btn-sm btn-outline-danger">Apagar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @* --- PAGINAÇÃO --- *@
    <div class="d-flex justify-content-center mt-3">
        <button class="btn btn-outline-primary me-2" @onclick="PaginaAnterior" disabled="@(PaginaAtual == 1)">Anterior</button>
        <span class="align-self-center">Página @PaginaAtual de @TotalPaginas</span>
        <button class="btn btn-outline-primary ms-2" @onclick="ProximaPagina" disabled="@(PaginaAtual >= TotalPaginas)">Seguinte</button>
    </div>
}

@code {
    private List<ModoEntrega>? modos;

    // Paginação
    private int PaginaAtual = 1;
    private const int TamanhoPagina = 10;
    private int TotalItens = 0;
    private int TotalPaginas => (int)Math.Ceiling((double)TotalItens / TamanhoPagina);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userDb = await UserManager.GetUserAsync(authState.User);
        if (userDb == null || userDb.Estado != "Ativo")
        {
            NavigationManager.NavigateTo("Account/AccessDenied");
            return;
        }

        await CarregarDados();
    }

    private async Task CarregarDados()
    {
        using var context = DbFactory.CreateDbContext();
        var query = context.ModosEntrega.OrderBy(m => m.Nome);

        TotalItens = await query.CountAsync();

        modos = await query
            .Skip((PaginaAtual - 1) * TamanhoPagina)
            .Take(TamanhoPagina)
            .ToListAsync();
    }

    private async Task PaginaAnterior()
    {
        if (PaginaAtual > 1) { PaginaAtual--; await CarregarDados(); }
    }

    private async Task ProximaPagina()
    {
        if (PaginaAtual < TotalPaginas) { PaginaAtual++; await CarregarDados(); }
    }
}