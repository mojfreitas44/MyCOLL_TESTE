@page "/produtos"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using GestaoLoja.Data
@using GestaoLoja.Entities
@using Microsoft.AspNetCore.Identity
@using System.Security.Claims

@attribute [Authorize(Roles = "Administrador,Funcionario,Fornecedor")]

@* --- INJEÇÕES NECESSÁRIAS --- *@
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject UserManager<ApplicationUser> UserManager
@rendermode InteractiveServer

<PageTitle>Gestão de Produtos</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Gestão de Produtos</h1>
    <div>
        <a href="produtos/create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Novo Colecionável
        </a>
        <AuthorizeView Roles="Administrador,Funcionario">
            <a href="produtos/pendentes" class="btn btn-warning ms-2">
                <i class="bi bi-exclamation-circle"></i> Aprovar Pendentes
            </a>
        </AuthorizeView>
    </div>
</div>

@* --- BARRA DE FILTROS --- *@
<div class="card p-3 mb-4 bg-light">
    <div class="row g-3 align-items-center">
        <div class="col-auto">
            <label class="col-form-label fw-bold">Filtrar por Estado:</label>
        </div>
        <div class="col-auto">
            <select class="form-select" @onchange="FiltrarPorEstado">
                <option value="Todos">Todos</option>
                <option value="Ativo" selected>Ativos (Na Loja)</option>
                <option value="Pendente">Pendentes</option>
                <option value="Inativo">Inativos (Escondidos)</option>
                <option value="Rejeitado">Rejeitados</option>
            </select>
        </div>
        <div class="col-auto ms-auto">
            <span class="text-muted">A mostrar <strong>@(produtos?.Count ?? 0)</strong> registos.</span>
        </div>
    </div>
</div>

@if (produtos == null)
{
    <p><em>A carregar produtos...</em></p>
}
else if (produtos.Count == 0)
{
    <div class="alert alert-warning">Não foram encontrados produtos com este filtro.</div>
}
else
{
    <table class="table table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Imagem</th>
                <th>Nome</th>
                <th>Categoria</th>
                <th>Preço Venda</th>
                <th>Estado</th>
                <th>Modo</th>
                <th class="text-end">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in produtos)
            {
                <tr>
                    <td>
                        @if (p.Imagem != null)
                        {
                            <img src="data:image;base64,@Convert.ToBase64String(p.Imagem)"
                                 class="img-thumbnail" style="width: 50px; height: 50px; object-fit: cover;" />
                        }
                        else
                        {
                            <span class="text-muted small">Sem foto</span>
                        }
                    </td>
                    <td>
                        <strong>@p.Nome</strong>
                        @if (ehFornecedor && p.FornecedorId == userId)
                        {
                            <span class="badge bg-info text-dark ms-1">Meu</span>
                        }
                    </td>
                    <td>@p.Categoria?.Nome</td>
                    <td>
                        @if (p.ParaVenda)
                        {
                            <span>@p.PrecoVenda.ToString("C")</span>
                        }
                        else
                        {
                            <span class="text-muted fst-italic">N/A</span>
                        }
                    </td>
                    <td>
                        <span class="badge @GetBadgeClass(p.Estado)">@p.Estado</span>
                    </td>
                    <td>
                        @if (p.ParaVenda)
                        {
                            <span class="badge bg-success"><i class="bi bi-cart"></i> Venda</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary"><i class="bi bi-collection"></i> Coleção</span>
                        }
                    </td>
                    <td class="text-end">
                        <a href="produtos/edit?id=@p.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                        <a href="produtos/delete?id=@p.Id" class="btn btn-sm btn-outline-danger ms-1">Apagar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Produto>? produtos;
    private string estadoFiltro = "Ativo";
    private string? userId;
    private bool ehFornecedor;

    protected override async Task OnInitializedAsync()
    {
        // 1. Obter o utilizador atual
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userPrincipal = authState.User;

        // --- SEGURANÇA EXTRA: Verificar se está ATIVO ---
        var userDb = await UserManager.GetUserAsync(userPrincipal);
        if (userDb == null || userDb.Estado != "Ativo")
        {
            NavigationManager.NavigateTo("Account/AccessDenied");
            return;
        }
        // ------------------------------------------------

        userId = userPrincipal.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        ehFornecedor = userPrincipal.IsInRole("Fornecedor");

        await CarregarProdutos();
    }

    private async Task FiltrarPorEstado(ChangeEventArgs e)
    {
        estadoFiltro = e.Value?.ToString() ?? "Todos";
        await CarregarProdutos();
    }

    private async Task CarregarProdutos()
    {
        using var context = DbFactory.CreateDbContext();
        var query = context.Produtos
            .Include(p => p.Categoria)
            .AsQueryable();

        // Se quiseres que o fornecedor só veja os seus, descomenta isto:
        /*
        if (ehFornecedor)
        {
             query = query.Where(p => p.FornecedorId == userId);
        }
        */

        if (estadoFiltro != "Todos")
        {
            query = query.Where(p => p.Estado == estadoFiltro);
        }

        produtos = await query.OrderByDescending(p => p.Id).ToListAsync();
    }

    private string GetBadgeClass(string estado) => estado switch
    {
        "Ativo" => "bg-success",
        "Pendente" => "bg-warning text-dark",
        "Inativo" => "bg-secondary",
        "Rejeitado" => "bg-danger",
        _ => "bg-light text-dark"
    };
}