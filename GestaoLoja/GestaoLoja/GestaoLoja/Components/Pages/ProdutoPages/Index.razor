@page "/produtos"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using GestaoLoja.Data
@using GestaoLoja.Entities
@using Microsoft.AspNetCore.Identity
@using System.Security.Claims

@attribute [Authorize(Roles = "Administrador,Funcionario,Fornecedor")]

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject UserManager<ApplicationUser> UserManager
@rendermode InteractiveServer

<PageTitle>Gestão de Produtos</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Gestão de Produtos</h1>
    <div>
        <a href="produtos/create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Novo Colecionável
        </a>
        <AuthorizeView Roles="Administrador,Funcionario">
            <a href="produtos/pendentes" class="btn btn-warning ms-2">
                <i class="bi bi-exclamation-circle"></i> Aprovar Pendentes
            </a>
        </AuthorizeView>
    </div>
</div>

@* --- BARRA DE FILTROS --- *@
<div class="card p-3 mb-4 bg-light">
    <div class="row g-3 align-items-center">
        <div class="col-md-3">
            <label class="form-label fw-bold">Estado</label>
            <select class="form-select" value="@estadoFiltro" @onchange="FiltrarPorEstado">
                <option value="Todos">Todos</option>
                <option value="Ativo">Ativos (Na Loja)</option>
                <option value="Pendente">Pendentes</option>
                <option value="Inativo">Inativos</option>
                <option value="Rejeitado">Rejeitados</option>
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label fw-bold">Categoria</label>
            <select class="form-select" @bind="categoriaFiltro">
                <option value="0">-- Todas --</option>
                @foreach (var cat in listaCategorias)
                {
                    <option value="@cat.Id">@cat.Nome</option>
                }
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label fw-bold">Tipo</label>
            <select class="form-select" @bind="tipoFiltro">
                <option value="Todos">Todos</option>
                <option value="Venda">Para Venda</option>
                <option value="Colecao">Apenas Coleção</option>
            </select>
        </div>

        <div class="col-md-3 align-self-end">
            <button class="btn btn-primary w-100" @onclick="AplicarFiltrosExtra">
                <i class="bi bi-search"></i> Aplicar Filtros
            </button>
        </div>

        <div class="col-12 text-end">
            <span class="text-muted small">
                Total: <strong>@totalItens</strong> |
                Pág. <strong>@paginaAtual</strong> de <strong>@TotalPaginas</strong>
            </span>
        </div>
    </div>
</div>

@if (produtos == null)
{
    <div class="d-flex justify-content-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else if (produtos.Count == 0)
{
    <div class="alert alert-warning">Não foram encontrados produtos.</div>
}
else
{
    <table class="table table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Imagem</th>
                <th>Nome</th>
                <th>Categoria</th>
                <th>Preço</th>
                <th>Condição</th> @* --- NOVA COLUNA --- *@
                <th>Estado</th>
                <th>Modo</th>
                <th class="text-end">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in produtos)
            {
                <tr>
                    <td>
                        @if (p.Imagem != null)
                        {
                            <img src="data:image;base64,@Convert.ToBase64String(p.Imagem)"
                                 class="img-thumbnail" style="width: 50px; height: 50px; object-fit: cover;" />
                        }
                        else
                        {
                            <span class="text-muted small">Sem foto</span>
                        }
                    </td>
                    <td>
                        <strong>@p.Nome</strong>
                        @if (ehFornecedor && p.FornecedorId == userId)
                        {
                            <span class="badge bg-info text-dark ms-1">Meu</span>
                        }
                    </td>
                    <td>@(p.Categoria?.Nome ?? "-")</td>
                    <td>
                        @if (p.ParaVenda)
                        {
                            <span class="fw-bold text-success">@p.PrecoVenda.ToString("C")</span>
                        }
                        else
                        {
                            <span class="text-muted fst-italic">N/A</span>
                        }
                    </td>
                    @* --- NOVA CÉLULA: CONDIÇÃO --- *@
                    <td>
                        <span class="badge @(p.Condicao == "Novo" ? "bg-primary" : "bg-light text-dark border")">
                            @p.Condicao
                        </span>
                    </td>
                    @* ----------------------------- *@
                    <td>
                        <span class="badge @GetBadgeClass(p.Estado)">@p.Estado</span>
                    </td>
                    <td>
                        @if (p.ParaVenda)
                        {
                            <span class="badge bg-success"><i class="bi bi-cart"></i> Venda</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary"><i class="bi bi-collection"></i> Coleção</span>
                        }
                    </td>
                    <td class="text-end">
                        <a href="produtos/edit?id=@p.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil"></i> Editar
                        </a>
                        <a href="produtos/delete?id=@p.Id" class="btn btn-sm btn-outline-danger ms-1">
                            <i class="bi bi-trash"></i> Apagar
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (TotalPaginas > 1)
    {
        <nav aria-label="Navegação">
            <ul class="pagination justify-content-center">
                <li class="page-item @(paginaAtual == 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="PaginaAnterior">Anterior</button>
                </li>
                <li class="page-item disabled">
                    <span class="page-link">@paginaAtual / @TotalPaginas</span>
                </li>
                <li class="page-item @(paginaAtual >= TotalPaginas ? "disabled" : "")">
                    <button class="page-link" @onclick="ProximaPagina">Seguinte</button>
                </li>
            </ul>
        </nav>
    }
}

@code {
    private List<Produto>? produtos;
    private List<Categoria> listaCategorias = new();

    // Filtros
    private string estadoFiltro = "Ativo";
    private int categoriaFiltro = 0;
    private string tipoFiltro = "Todos";

    private string? userId;
    private bool ehFornecedor;

    // Paginação
    private int paginaAtual = 1;
    private const int tamanhoPagina = 10;
    private int totalItens = 0;
    private int TotalPaginas => (int)Math.Ceiling((double)totalItens / tamanhoPagina);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userPrincipal = authState.User;
        var userDb = await UserManager.GetUserAsync(userPrincipal);

        if (userDb == null || userDb.Estado != "Ativo")
        {
            NavigationManager.NavigateTo("Account/AccessDenied");
            return;
        }

        userId = userPrincipal.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        ehFornecedor = userPrincipal.IsInRole("Fornecedor");

        using var context = DbFactory.CreateDbContext();
        listaCategorias = await context.Categorias.OrderBy(c => c.Nome).ToListAsync();

        await CarregarProdutos();
    }

    private async Task FiltrarPorEstado(ChangeEventArgs e)
    {
        estadoFiltro = e.Value?.ToString() ?? "Todos";
        await AplicarFiltrosExtra();
    }

    private async Task AplicarFiltrosExtra()
    {
        paginaAtual = 1;
        await CarregarProdutos();
    }

    private async Task PaginaAnterior()
    {
        if (paginaAtual > 1)
        {
            paginaAtual--;
            await CarregarProdutos();
        }
    }

    private async Task ProximaPagina()
    {
        if (paginaAtual < TotalPaginas)
        {
            paginaAtual++;
            await CarregarProdutos();
        }
    }

    private async Task CarregarProdutos()
    {
        using var context = DbFactory.CreateDbContext();
        var query = context.Produtos
            .Include(p => p.Categoria)
            .AsQueryable();

        // Filtro Estado
        if (estadoFiltro != "Todos")
        {
            query = query.Where(p => p.Estado == estadoFiltro);
        }

        // Filtro Categoria
        if (categoriaFiltro > 0)
        {
            query = query.Where(p => p.CategoriaId == categoriaFiltro);
        }

        // Filtro Tipo (Venda vs Coleção)
        if (tipoFiltro == "Venda")
        {
            query = query.Where(p => p.ParaVenda == true);
        }
        else if (tipoFiltro == "Colecao")
        {
            query = query.Where(p => p.ParaVenda == false);
        }

        // Paginação
        totalItens = await query.CountAsync();
        produtos = await query
            .OrderByDescending(p => p.Id)
            .Skip((paginaAtual - 1) * tamanhoPagina)
            .Take(tamanhoPagina)
            .ToListAsync();
    }

    private string GetBadgeClass(string estado) => estado switch
    {
        "Ativo" => "bg-success",
        "Pendente" => "bg-warning text-dark",
        "Inativo" => "bg-secondary",
        "Rejeitado" => "bg-danger",
        _ => "bg-light text-dark"
    };
}