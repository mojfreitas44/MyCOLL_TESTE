@page "/produtos/edit"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using GestaoLoja.Data
@using GestaoLoja.Entities
@using System.IO
@using System.Security.Claims
@using Microsoft.AspNetCore.Identity

@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrador,Funcionario,Fornecedor")]

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Editar Produto</PageTitle>

<h1>Editar Produto</h1>
<hr />

@if (Produto is null)
{
    <p><em>A carregar...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-6">
            <EditForm Model="Produto" OnValidSubmit="AtualizarProduto" FormName="edit_prod" method="post" enctype="multipart/form-data">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />

                <input type="hidden" name="Produto.Id" value="@Produto.Id" />

                @if (!string.IsNullOrEmpty(mensagemErro))
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <strong>Atenção!</strong> @mensagemErro
                        <button type="button" class="btn-close" @onclick="() => mensagemErro = null"></button>
                    </div>
                }

                <AuthorizeView Roles="Fornecedor" Context="fornecedorContext">
                    <div class="alert alert-warning">
                        <strong>Nota:</strong> Ao alterar os dados deste produto, ele voltará automaticamente para o estado
                        <span class="badge bg-warning text-dark">Pendente</span> e terá de ser reavaliado.
                    </div>
                </AuthorizeView>

                @if (!string.IsNullOrEmpty(erroImagem))
                {
                    <div class="alert alert-danger">@erroImagem</div>
                }

                <div class="mb-3">
                    <label class="form-label">Imagem Atual</label>
                    @if (Produto.Imagem != null)
                    {
                        <div class="mb-2">
                            <img src="data:image;base64,@Convert.ToBase64String(Produto.Imagem)" style="max-width: 200px; border-radius: 5px;" />
                        </div>
                    }
                    <InputFile OnChange="CarregarImagem" class="form-control" accept=".png,.jpg,.jpeg" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Nome</label>
                    <InputText @bind-Value="Produto.Nome" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Categoria</label>
                    <InputSelect @bind-Value="Produto.CategoriaId" class="form-select">
                        @foreach (var cat in categorias)
                        {
                            <option value="@cat.Id">@cat.Nome</option>
                        }
                    </InputSelect>
                </div>

                <div class="mb-3">
                    <label class="form-label">Descrição</label>
                    <InputTextArea @bind-Value="Produto.Descricao" class="form-control" rows="3" />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Preço Base (€)</label>
                        <InputNumber @bind-Value="Produto.PrecoBase" class="form-control" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Stock</label>
                        <InputNumber @bind-Value="Produto.Stock" class="form-control" />
                    </div>
                </div>

                <AuthorizeView Roles="Administrador,Funcionario" Context="authContext">
                    <div class="card bg-light mb-3">
                        <div class="card-body">
                            <h5 class="card-title">Área de Gestão</h5>
                            <div class="mb-3">
                                <label class="form-label">Preço de Venda (Final)</label>
                                <InputNumber @bind-Value="Produto.PrecoVenda" class="form-control" min="@Produto.PrecoBase" />
                                <div class="form-text">
                                    O Preço de Venda deve ser superior ou igual a @Produto.PrecoBase.ToString("C").
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Estado</label>
                                <InputSelect @bind-Value="Produto.Estado" class="form-select">
                                    <option value="Pendente">Pendente</option>
                                    <option value="Ativo">Ativo</option>
                                    <option value="Inativo">Inativo</option>
                                    <option value="Rejeitado">Rejeitado</option>
                                </InputSelect>
                            </div>
                        </div>
                    </div>
                </AuthorizeView>

                <div class="mb-3 form-check">
                    <InputCheckbox @bind-Value="Produto.ParaVenda" class="form-check-input" id="paraVenda" />
                    <label class="form-check-label" for="paraVenda">Disponível para Venda?</label>
                </div>

                <button type="submit" class="btn btn-primary">Guardar Alterações</button>
                <a href="produtos" class="btn btn-secondary">Cancelar</a>
            </EditForm>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery]
    public int Id { get; set; }

    [SupplyParameterFromForm]
    public Produto? Produto { get; set; }

    private List<Categoria> categorias = new();
    private string? erroImagem;
    private string? mensagemErro;

    protected override async Task OnInitializedAsync()
    {
        // --- SEGURANÇA: PORTEIRO ---
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userDb = await UserManager.GetUserAsync(authState.User);
        if (userDb == null || userDb.Estado != "Ativo")
        {
            NavigationManager.NavigateTo("Account/AccessDenied");
            return;
        }
        // ---------------------------

        using var context = DbFactory.CreateDbContext();
        categorias = await context.Categorias.OrderBy(c => c.Nome).ToListAsync();

        if (Produto is null)
        {
            Produto = await context.Produtos.FirstOrDefaultAsync(p => p.Id == Id);
            if (Produto is null) NavigationManager.NavigateTo("produtos");
        }
    }

    private async Task CarregarImagem(InputFileChangeEventArgs e)
    {
        try
        {
            var ficheiro = e.File;
            if (ficheiro != null)
            {
                var maxTamanho = 5 * 1024 * 1024;
                using var stream = ficheiro.OpenReadStream(maxTamanho);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                Produto!.Imagem = ms.ToArray();
                Produto.ImagemUrl = ficheiro.Name;
            }
        }
        catch (Exception ex)
        {
            erroImagem = "Erro na imagem: " + ex.Message;
        }
    }

    private async Task AtualizarProduto()
    {
        mensagemErro = null;
        using var context = DbFactory.CreateDbContext();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        bool isAdminOrStaff = user.IsInRole("Administrador") || user.IsInRole("Funcionario");

        if (!isAdminOrStaff)
        {
            Produto!.Estado = "Pendente";
        }
        else
        {
            if (Produto!.PrecoVenda < Produto.PrecoBase)
            {
                mensagemErro = $"Erro: O Preço de Venda ({Produto.PrecoVenda:C}) não pode ser inferior ao Preço Base ({Produto.PrecoBase:C}).";
                return;
            }
        }

        context.Attach(Produto!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
            NavigationManager.NavigateTo("produtos");
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!context.Produtos.Any(e => e.Id == Produto!.Id))
                NavigationManager.NavigateTo("produtos");
            else
                throw;
        }
    }
}