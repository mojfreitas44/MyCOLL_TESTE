@page "/produtos/delete"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using GestaoLoja.Data
@using GestaoLoja.Entities
@using Microsoft.AspNetCore.Identity

@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrador,Funcionario,Fornecedor")]

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Apagar Produto</PageTitle>

<h1>Apagar Produto</h1>

@if (mensagemErro != null)
{
    <div class="alert alert-danger">@mensagemErro</div>
}

@if (produto is null)
{
    <p><em>A carregar...</em></p>
}
else
{
    <div class="card mt-4" style="max-width: 600px;">
        <div class="row g-0">
            <div class="col-md-4 d-flex align-items-center justify-content-center bg-light">
                @if (produto.Imagem != null)
                {
                    <img src="data:image;base64,@Convert.ToBase64String(produto.Imagem)" class="img-fluid rounded-start" style="max-height: 150px;" />
                }
                else
                {
                    <span class="text-muted">Sem imagem</span>
                }
            </div>
            <div class="col-md-8">
                <div class="card-body">
                    <h5 class="card-title">@produto.Nome</h5>
                    <p class="card-text">@produto.Descricao</p>
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Preço</dt>
                        <dd class="col-sm-8">@produto.PrecoVenda.ToString("C")</dd>
                        <dt class="col-sm-4">Estado</dt>
                        <dd class="col-sm-8">@produto.Estado</dd>
                    </dl>
                </div>
            </div>
        </div>
        <div class="card-footer text-end">
            @if (podeApagar)
            {
                <button class="btn btn-danger" @onclick="ApagarProduto">Confirmar Eliminação</button>
            }
            else
            {
                <button class="btn btn-secondary" disabled>Impossível Apagar</button>
            }
            <a href="produtos" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </div>
}

@code {
    private Produto? produto;
    private string? mensagemErro;
    private bool podeApagar = true;

    [SupplyParameterFromQuery]
    public int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // 1. Validação de Segurança e Estado do Utilizador
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userDb = await UserManager.GetUserAsync(authState.User);

        if (userDb == null || userDb.Estado != "Ativo")
        {
            NavigationManager.NavigateTo("Account/AccessDenied");
            return;
        }

        // 2. Carregamento da Entidade
        using var context = DbFactory.CreateDbContext();
        produto = await context.Produtos.FirstOrDefaultAsync(m => m.Id == Id);

        if (produto is null)
        {
            NavigationManager.NavigateTo("produtos");
            return;
        }
    }

    private async Task ApagarProduto()
    {
        using var context = DbFactory.CreateDbContext();
        try
        {
            // 3. Remoção Física
            context.Produtos.Remove(produto!);
            await context.SaveChangesAsync();
            NavigationManager.NavigateTo("produtos");
        }
        catch (DbUpdateException)
        {
            // 4. Tratamento de Restrições de Integridade Referencial (FKs)
            // Impede a remoção se o produto estiver associado a encomendas históricas
            mensagemErro = "Este produto não pode ser apagado porque já faz parte de encomendas passadas. Sugestão: Mude o estado para 'Inativo'.";
            podeApagar = false; // Bloqueia o botão
        }
        catch (Exception ex)
        {
            // 5. Tratamento de Erros Genéricos
            mensagemErro = "Erro inesperado: " + ex.Message;
        }
    }
}