@page "/produtos/create"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using GestaoLoja.Data
@using GestaoLoja.Entities
@using System.Security.Claims
@using System.IO
@using Microsoft.AspNetCore.Identity

@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrador,Funcionario,Fornecedor")]

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Novo Colecionável</PageTitle>

<h1>Registar Novo Colecionável</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <EditForm Model="Produto" OnValidSubmit="SalvarProduto" FormName="create_prod" method="post" enctype="multipart/form-data">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" />

            @if (!string.IsNullOrEmpty(erroImagem))
            {
                <div class="alert alert-danger">@erroImagem</div>
            }

            <div class="mb-3">
                <label class="form-label">Nome do Artigo</label>
                <InputText @bind-Value="Produto.Nome" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Categoria</label>
                <InputSelect @bind-Value="Produto.CategoriaId" class="form-select">
                    <option value="">-- Selecione --</option>
                    @foreach (var cat in categorias)
                    {
                        <option value="@cat.Id">@cat.Nome</option>
                    }
                </InputSelect>
            </div>

            <div class="mb-3">
                <label class="form-label">Condição</label>
                <InputSelect @bind-Value="Produto.Condicao" class="form-select">
                    <option value="Usado">Usado</option>
                    <option value="Novo">Novo</option>
                </InputSelect>
            </div>

            <div class="mb-3">
                <label class="form-label">Descrição</label>
                <InputTextArea @bind-Value="Produto.Descricao" class="form-control" rows="3" />
            </div>

            <div class="mb-3">
                <label class="form-label">Imagem do Artigo</label>
                <InputFile OnChange="CarregarImagem" class="form-control" accept=".png,.jpg,.jpeg" />
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Preço Base (€)</label>
                    <InputNumber @bind-Value="Produto.PrecoBase" class="form-control" />
                    <div class="form-text">Valor pretendido pelo fornecedor.</div>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Stock</label>
                    <InputNumber @bind-Value="Produto.Stock" class="form-control" />
                </div>
            </div>

            <div class="form-check mb-3">
                <InputCheckbox @bind-Value="Produto.ParaVenda" class="form-check-input" id="paraVenda" />
                <label class="form-check-label" for="paraVenda">
                    Disponível para venda?
                    (Se não, é apenas coleção)
                </label>
            </div>

            <button type="submit" class="btn btn-success">Submeter</button>
            <a href="produtos" class="btn btn-secondary">Cancelar</a>
        </EditForm>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    public Produto Produto { get; set; } = new() { Condicao = "Usado" }; // Define padrão aqui

    private List<Categoria> categorias = new();
    private string? erroImagem;

    protected override async Task OnInitializedAsync()
    {
        // --- SEGURANÇA ---
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userDb = await UserManager.GetUserAsync(authState.User);
        if (userDb == null || userDb.Estado != "Ativo")
        {
            NavigationManager.NavigateTo("Account/AccessDenied");
            return;
        }
        // ---------------------------

        using var context = DbFactory.CreateDbContext();
        categorias = await context.Categorias.OrderBy(c => c.Nome).ToListAsync();
    }

    private async Task CarregarImagem(InputFileChangeEventArgs e)
    {
        try
        {
            var ficheiro = e.File;
            if (ficheiro != null)
            {
                var maxTamanho = 5 * 1024 * 1024;
                using var stream = ficheiro.OpenReadStream(maxTamanho);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                Produto.Imagem = ms.ToArray();
                Produto.ImagemUrl = ficheiro.Name;
            }
        }
        catch (Exception ex)
        {
            erroImagem = "Erro ao carregar imagem: " + ex.Message;
        }
    }

    private async Task SalvarProduto()
    {
        using var context = DbFactory.CreateDbContext();
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        Produto.FornecedorId = userId;
        Produto.Estado = "Pendente";
        Produto.PrecoVenda = Produto.PrecoBase;

        context.Produtos.Add(Produto);
        await context.SaveChangesAsync();

        NavigationManager.NavigateTo("produtos/pendentes");
    }
}