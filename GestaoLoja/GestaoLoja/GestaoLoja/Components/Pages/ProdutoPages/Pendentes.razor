@page "/produtos/pendentes"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using GestaoLoja.Data
@using GestaoLoja.Entities
@using Microsoft.AspNetCore.Identity

@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrador,Funcionario")]

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Produtos Pendentes</PageTitle>

<h1>Aprovação de Colecionáveis</h1>

@if (pendentes == null)
{
    <p><em>A carregar...</em></p>
}
else if (!pendentes.Any())
{
    <div class="alert alert-success">
        Tudo limpo! Não há produtos pendentes.
    </div>
}
else
{
    <table class="table align-middle table-hover">
        <thead class="table-dark">
            <tr>
                <th>Imagem</th>
                <th>Artigo</th>
                <th>Preço Base</th>
                <th>Margem (%)</th>
                <th>Preço Final</th>
                <th class="text-end">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in pendentes)
            {
                var margem = margens.ContainsKey(p.Id) ? margens[p.Id] : 20;
                var precoFinal = p.PrecoBase + (p.PrecoBase * (margem / 100));

                <tr>
                    <td>
                        @* --- CORREÇÃO AQUI (data:image/png) --- *@
                        @if (p.Imagem != null && p.Imagem.Length > 0)
                        {
                            <img src="data:image/png;base64,@Convert.ToBase64String(p.Imagem)"
                                 class="img-thumbnail"
                                 style="width: 50px; height: 50px; object-fit: cover;" />
                        }
                        else
                        {
                            <span class="text-muted small">Sem foto</span>
                        }
                    </td>
                    <td>
                        <strong>@p.Nome</strong><br />
                        <small class="text-muted">@(p.Categoria?.Nome ?? "Sem Categoria")</small>
                        <br />
                        @* Mostra quem criou o produto *@
                        <small class="text-secondary">Forn: @(p.Fornecedor?.Nome ?? p.Fornecedor?.UserName ?? "Desconhecido")</small>
                    </td>
                    <td>@p.PrecoBase.ToString("C")</td>
                    <td style="width:120px">
                        <input type="number" class="form-control form-control-sm"
                               value="@margem"
                               @onchange="@(e => AtualizarMargem(p.Id, e.Value))" />
                    </td>
                    <td class="fw-bold text-success">@precoFinal.ToString("C")</td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-success" @onclick="() => Aprovar(p)">Aprovar</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => Rejeitar(p)">Recusar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @* --- PAGINAÇÃO --- *@
    <div class="d-flex justify-content-center mt-3">
        <button class="btn btn-outline-primary me-2" @onclick="PaginaAnterior" disabled="@(PaginaAtual == 1)">Anterior</button>
        <span class="align-self-center">Página @PaginaAtual de @TotalPaginas</span>
        <button class="btn btn-outline-primary ms-2" @onclick="ProximaPagina" disabled="@(PaginaAtual >= TotalPaginas)">Seguinte</button>
    </div>
}

@code {
    private List<Produto>? pendentes;
    private Dictionary<int, decimal> margens = new();

    // Paginação
    private int PaginaAtual = 1;
    private const int TamanhoPagina = 10;
    private int TotalItens = 0;
    private int TotalPaginas => (int)Math.Ceiling((double)TotalItens / TamanhoPagina);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userDb = await UserManager.GetUserAsync(authState.User);

        if (userDb == null || userDb.Estado != "Ativo")
        {
            NavigationManager.NavigateTo("Account/AccessDenied");
            return;
        }

        await CarregarDados();
    }

    private async Task CarregarDados()
    {
        using var context = DbFactory.CreateDbContext();
        var query = context.Produtos
            .Include(p => p.Categoria)
            .Include(p => p.Fornecedor)
            .Where(p => p.Estado == "Pendente");

        // 1. Contar total
        TotalItens = await query.CountAsync();

        // 2. Buscar página
        pendentes = await query
            .OrderBy(p => p.Id)
            .Skip((PaginaAtual - 1) * TamanhoPagina)
            .Take(TamanhoPagina)
            .ToListAsync();

        // Inicializar margens
        margens.Clear();
        foreach (var p in pendentes)
        {
            margens[p.Id] = 20;
        }
    }

    private async Task PaginaAnterior()
    {
        if (PaginaAtual > 1) { PaginaAtual--; await CarregarDados(); }
    }

    private async Task ProximaPagina()
    {
        if (PaginaAtual < TotalPaginas) { PaginaAtual++; await CarregarDados(); }
    }

    private void AtualizarMargem(int id, object? val)
    {
        if (decimal.TryParse(val?.ToString(), out decimal m))
        {
            margens[id] = m;
        }
    }

    private async Task Aprovar(Produto p)
    {
        using var context = DbFactory.CreateDbContext();
        var prod = await context.Produtos.FindAsync(p.Id);

        if (prod != null)
        {
            decimal m = margens.ContainsKey(p.Id) ? margens[p.Id] : 20;
            prod.PrecoVenda = prod.PrecoBase + (prod.PrecoBase * (m / 100));
            prod.Estado = "Ativo";

            await context.SaveChangesAsync();
            await CarregarDados();
        }
    }

    private async Task Rejeitar(Produto p)
    {
        using var context = DbFactory.CreateDbContext();
        var prod = await context.Produtos.FindAsync(p.Id);

        if (prod != null)
        {
            prod.Estado = "Rejeitado";
            await context.SaveChangesAsync();
            await CarregarDados();
        }
    }
}