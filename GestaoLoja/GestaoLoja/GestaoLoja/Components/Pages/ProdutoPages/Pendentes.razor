@page "/produtos/pendentes"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using GestaoLoja.Data
@using GestaoLoja.Entities

@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrador,Funcionario")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>Produtos Pendentes</PageTitle>

<h1>Aprovação de Colecionáveis</h1>

@if (pendentes == null)
{
    <p><em>A carregar...</em></p>
}
else if (!pendentes.Any())
{
    <div class="alert alert-info">Nada para aprovar.</div>
}
else
{
    <table class="table align-middle table-hover">
        <thead>
            <tr>
                <th>Imagem</th>
                <th>Artigo</th>
                <th>Preço Base</th>
                <th>Margem (%)</th>
                <th>Preço Final</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in pendentes)
            {
                // Lógica local para a margem
                var margem = margens.ContainsKey(p.Id) ? margens[p.Id] : 20; // 20% default
                var precoFinal = p.PrecoBase + (p.PrecoBase * (margem / 100));

                <tr>
                    <td>
                        @if (p.Imagem != null)
                        {
                            <img src="data:image;base64,@Convert.ToBase64String(p.Imagem)" width="50" class="img-thumbnail" />
                        }
                    </td>
                    <td>
                        <strong>@p.Nome</strong><br />
                        <small class="text-muted">@p.Categoria?.Nome</small>
                    </td>
                    <td>@p.PrecoBase.ToString("C")</td>
                    <td style="width:120px">
                        <input type="number" class="form-control form-control-sm"
                               value="@margem"
                               @onchange="@(e => AtualizarMargem(p.Id, e.Value))" />
                    </td>
                    <td class="fw-bold text-success">@precoFinal.ToString("C")</td>
                    <td>
                        <button class="btn btn-sm btn-success" @onclick="() => Aprovar(p)">Aprovar</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => Rejeitar(p)">Recusar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Produto>? pendentes;
    private Dictionary<int, decimal> margens = new();

    protected override async Task OnInitializedAsync()
    {
        await CarregarDados();
    }

    private async Task CarregarDados()
    {
        using var context = DbFactory.CreateDbContext();
        pendentes = await context.Produtos
            .Include(p => p.Categoria)
            .Include(p => p.Fornecedor)
            .Where(p => p.Estado == "Pendente")
            .ToListAsync();

        // Inicializa dicionário de margens
        foreach (var p in pendentes)
        {
            if (!margens.ContainsKey(p.Id)) margens[p.Id] = 20;
        }
    }

    private void AtualizarMargem(int id, object? val)
    {
        if (decimal.TryParse(val?.ToString(), out decimal m))
        {
            margens[id] = m;
        }
    }

    private async Task Aprovar(Produto p)
    {
        using var context = DbFactory.CreateDbContext();
        var prod = await context.Produtos.FindAsync(p.Id);
        if (prod != null)
        {
            decimal m = margens[p.Id];
            prod.PrecoVenda = prod.PrecoBase + (prod.PrecoBase * (m / 100));
            prod.Estado = "Ativo";

            await context.SaveChangesAsync();
            await CarregarDados();
        }
    }

    private async Task Rejeitar(Produto p)
    {
        using var context = DbFactory.CreateDbContext();
        var prod = await context.Produtos.FindAsync(p.Id);
        if (prod != null)
        {
            // Podes mudar o estado ou apagar
            prod.Estado = "Rejeitado";
            await context.SaveChangesAsync();
            await CarregarDados();
        }
    }
}