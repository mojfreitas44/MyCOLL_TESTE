@page "/encomendas"
@using RCLAPI.DTO
@using RCLAPI.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Globalization
@inject EncomendasCliente EncomendasSvc
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

<div class="container py-5">
    <h2 class="fw-bold mb-4 text-dark"><i class="bi bi-box-seam me-2"></i>Histórico de Encomendas</h2>

    @if (!string.IsNullOrEmpty(mensagemErro))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @mensagemErro
            <button type="button" class="btn-close" @onclick='() => mensagemErro = ""'></button>
        </div>
    }

    @* --- FILTROS --- *@
    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body">
            <h6 class="card-title fw-bold text-muted mb-3"><i class="bi bi-funnel me-1"></i>Filtros</h6>
            <div class="row g-3">
                <div class="col-md-2">
                    <input type="number" class="form-control form-control-sm" placeholder="Nº Encomenda" min="1"
                           @bind="filtroId" @bind:event="oninput" @onkeyup="AplicarFiltros" />
                </div>
                <div class="col-md-3">
                    <select class="form-select form-select-sm" @bind="filtroEstado" @onclick="AplicarFiltros">
                        <option value="">-- Todos os Estados --</option>
                        <option value="Pendente">Pendente</option>
                        <option value="Pago">A Preparar Expedição...</option>
                        <option value="Enviado">Enviado</option>
                        <option value="Entregue">Entregue</option>
                        <option value="Concluido">Concluido</option>
                        <option value="Cancelada">Cancelada</option>
                    </select>
                </div>

                @* DATA INÍCIO *@
                <div class="col-md-3">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text">De</span>
                        <input type="text" class="form-control"
                               placeholder="dd/mm/aaaa"
                               maxlength="10"
                               value="@filtroDataInicioTexto"
                               @oninput="AoDigitarDataInicio" />
                    </div>
                </div>

                @* DATA FIM *@
                <div class="col-md-3">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text">Até</span>
                        <input type="text" class="form-control"
                               placeholder="dd/mm/aaaa"
                               maxlength="10"
                               value="@filtroDataFimTexto"
                               @oninput="AoDigitarDataFim" />
                    </div>
                </div>

                <div class="col-md-1 d-grid">
                    <button class="btn btn-primary btn-sm" @onclick="AplicarFiltros">
                        <i class="bi bi-search me-1"></i>Filtrar
                    </button>
                </div>
            </div>
            <div class="row mt-2">
                <div class="col-12 text-end">
                    <button class="btn btn-link btn-sm text-decoration-none text-muted p-0" @onclick="LimparFiltros">
                        Limpar Filtros
                    </button>
                </div>
            </div>
        </div>
    </div>

    @* --- TABELA --- *@
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">A carregar...</p>
        </div>
    }
    else if (encomendasFiltradas == null || !encomendasFiltradas.Any())
    {
        <div class="alert alert-info rounded-4 border-0 shadow-sm">
            <i class="bi bi-info-circle me-2"></i>
            @if (encomendas != null && encomendas.Any())
            {
                <span>Não foram encontradas encomendas com estes filtros.</span>
            }
            else
            {
                <span>Ainda não tens encomendas registadas.</span>
            }
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-hover align-middle mb-0 bg-white">
                <thead class="bg-light text-secondary">
                    <tr>
                        <th class="py-3 ps-4">Nº Enc.</th>
                        <th class="py-3">Data</th>
                        <th class="py-3">Total</th>
                        <th class="py-3">Estado</th>
                        <th class="py-3 text-end pe-4">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var enc in encomendasFiltradas)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-primary">#@enc.Id</td>
                            <td>@enc.Data.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="fw-bold">@enc.ValorTotal.ToString("C2")</td>
                            <td>
                                <span class="badge @GetStatusColor(enc.Estado)">
                                    @(enc.Estado == "Pago" ? "A Preparar Expedição..." : enc.Estado)
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <a href="encomenda/@enc.Id" class="btn btn-sm btn-outline-primary me-2">
                                    <i class="bi bi-eye me-1"></i>Detalhes
                                </a>
                                @if (enc.Estado == "Enviado")
                                {
                                    <button class="btn btn-sm btn-success" @onclick="() => MarcarComoRecebida(enc)">
                                        <i class="bi bi-check-circle me-1"></i>Recebi
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="text-muted small mt-2 text-end">
            A mostrar @encomendasFiltradas.Count de @encomendas.Count encomendas
        </div>
    }
</div>

@code {
    private List<EncomendaDTO> encomendas = new();
    private List<EncomendaDTO> encomendasFiltradas = new();

    private bool isLoading = true;
    private string mensagemErro = "";

    // Filtros
    private int? filtroId;
    private string filtroEstado = "";

    private string filtroDataInicioTexto = "";
    private string filtroDataFimTexto = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!authState.User.Identity?.IsAuthenticated ?? true)
        {
            Nav.NavigateTo("login");
            return;
        }

        try
        {
            encomendas = await EncomendasSvc.GetMinhasEncomendas();
            encomendas = encomendas.OrderByDescending(x => x.Data).ToList();
            encomendasFiltradas = encomendas;
        }
        catch
        {
            encomendas = new List<EncomendaDTO>();
        }
        isLoading = false;
    }

    private void AplicarFiltros()
    {
        var temp = encomendas.AsEnumerable();

        if (filtroId.HasValue && filtroId.Value > 0)
        {
            temp = temp.Where(e => e.Id == filtroId.Value);
        }

        if (!string.IsNullOrEmpty(filtroEstado))
        {
            temp = temp.Where(e => e.Estado.Equals(filtroEstado, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(filtroDataInicioTexto) &&
            DateTime.TryParseExact(filtroDataInicioTexto, "dd/MM/yyyy", null, DateTimeStyles.None, out DateTime dataIni))
        {
            temp = temp.Where(e => e.Data.Date >= dataIni.Date);
        }

        if (!string.IsNullOrWhiteSpace(filtroDataFimTexto) &&
            DateTime.TryParseExact(filtroDataFimTexto, "dd/MM/yyyy", null, DateTimeStyles.None, out DateTime dataFim))
        {
            temp = temp.Where(e => e.Data.Date <= dataFim.Date);
        }

        encomendasFiltradas = temp.ToList();
    }

    private void AoDigitarDataInicio(ChangeEventArgs e)
    {
        filtroDataInicioTexto = AplicarMascaraInteligente(e.Value?.ToString() ?? "");
    }

    private void AoDigitarDataFim(ChangeEventArgs e)
    {
        filtroDataFimTexto = AplicarMascaraInteligente(e.Value?.ToString() ?? "");
    }

    private string AplicarMascaraInteligente(string valor)
    {
        // 1. Apenas números
        string nums = new string(valor.Where(char.IsDigit).ToArray());
        if (nums.Length > 8) nums = nums.Substring(0, 8);

        // 2. Validações de Calendário
        if (nums.Length >= 2) // Validar Dia
        {
            int dia = int.Parse(nums.Substring(0, 2));
            if (dia == 0) nums = "01" + nums.Substring(2);
            if (dia > 31) nums = "31" + nums.Substring(2);
        }

        if (nums.Length >= 4) // Validar Mês e Consistência
        {
            int mes = int.Parse(nums.Substring(2, 2));
            if (mes == 0) nums = nums.Substring(0, 2) + "01" + nums.Substring(4);
            if (mes > 12) nums = nums.Substring(0, 2) + "12" + nums.Substring(4);

            // Re-validar dia com base no mês (ex: 31/02 -> 29/02)
            // Usamos 2024 (ano bissexto) como base para permitir 29/02 durante a digitação
            int dia = int.Parse(nums.Substring(0, 2));
            mes = int.Parse(nums.Substring(2, 2)); // Refresh no valor
            int maxDias = DateTime.DaysInMonth(2024, mes);

            if (dia > maxDias)
            {
                nums = maxDias.ToString("D2") + mes.ToString("D2") + nums.Substring(4);
            }
        }

        // 3. Validação Básica de Ano (Impede começar com 0 ou 1, forçando 20xx)
        if (nums.Length >= 5)
        {
            // Se o 5º digito (1º do ano) não for '2', remove-o ou força 2
            char primeiroDigitoAno = nums[4];
            if (primeiroDigitoAno != '2')
            {
                // Opção: forçar '2' para ser amigável
                nums = nums.Substring(0, 4) + "2" + nums.Substring(5);
            }
        }

        // 4. Formatação Visual (Barras)
        if (nums.Length > 4)
            return $"{nums.Substring(0, 2)}/{nums.Substring(2, 2)}/{nums.Substring(4)}";
        if (nums.Length > 2)
            return $"{nums.Substring(0, 2)}/{nums.Substring(2)}";

        return nums;
    }
    // --------------------------------

    private void LimparFiltros()
    {
        filtroId = null;
        filtroEstado = "";
        filtroDataInicioTexto = "";
        filtroDataFimTexto = "";
        encomendasFiltradas = encomendas;
    }

    private async Task MarcarComoRecebida(EncomendaDTO encomenda)
    {
        mensagemErro = "";
        bool sucesso = await EncomendasSvc.ConfirmarRececao(encomenda.Id);
        if (sucesso)
        {
            encomenda.Estado = "Entregue";
            StateHasChanged();
        }
        else
        {
            mensagemErro = $"Erro ao confirmar encomenda #{encomenda.Id}.";
        }
    }

    private string GetStatusColor(string estado)
    {
        return estado switch
        {
            "Pendente" => "bg-warning text-dark",
            "Pago" => "bg-info text-dark",
            "Enviado" => "bg-primary",
            "Entregue" => "bg-success",
            "Concluido" => "bg-dark text-white",
            "Cancelada" => "bg-danger",
            _ => "bg-secondary"
        };
    }
}