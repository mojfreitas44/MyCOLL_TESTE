@page "/perfil"
@using Microsoft.AspNetCore.Authorization
@using RCLAPI.DTO
@using RCLAPI.Services
@inject AuthService AuthService
@inject NavigationManager Navigation
@attribute [Authorize]

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0">
                <div class="card-header bg-primary text-white text-center py-3">
                    <h3 class="mb-0"><i class="bi bi-person-lines-fill me-2"></i>O Meu Perfil</h3>
                </div>
                <div class="card-body p-4">

                    @if (isLoading)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">A carregar...</span>
                            </div>
                        </div>
                    }
                    else if (loadError)
                    {
                        <div class="alert alert-danger">
                            <strong>Ocorreu um erro ao carregar os dados:</strong>
                            <br />
                            <code>@debugErro</code>
                            <br /><br />
                            <small>Se for erro 401, a página deverá redirecionar para o login automaticamente.</small>
                        </div>
                    }
                    else
                    {
                        @* --- MENSAGENS DE FEEDBACK GERAIS --- *@
                        @if (!string.IsNullOrEmpty(mensagemSucesso))
                        {
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                @mensagemSucesso
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(mensagemErro))
                        {
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                @mensagemErro
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        @* ======================================================================== *@
                        @* 1. FORMULÁRIO DE DADOS PESSOAIS E MORADA *@
                        @* ======================================================================== *@
                        <EditForm Model="@perfilModel" OnValidSubmit="GuardarAlteracoes">
                            <DataAnnotationsValidator />

                            <h5 class="text-primary mb-3 border-bottom pb-2">Dados Pessoais</h5>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">Nome</label>
                                    <InputText class="form-control" @bind-Value="perfilModel.Nome" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Apelido</label>
                                    <InputText class="form-control" @bind-Value="perfilModel.Apelido" />
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">NIF</label>
                                    <InputNumber class="form-control" @bind-Value="perfilModel.NIF" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Telemóvel</label>
                                    <InputText class="form-control" @bind-Value="perfilModel.Telemovel" />
                                </div>
                            </div>

                            <h5 class="text-primary mt-4 mb-3 border-bottom pb-2">Morada</h5>

                            <div class="mb-3">
                                <label class="form-label">Rua</label>
                                <InputText class="form-control" @bind-Value="perfilModel.Morada.Rua" />
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">Código Postal</label>
                                    <InputText class="form-control" @bind-Value="perfilModel.Morada.CodigoPostal" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Localidade</label>
                                    <InputText class="form-control" @bind-Value="perfilModel.Morada.Localidade" />
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">Cidade</label>
                                    <InputText class="form-control" @bind-Value="perfilModel.Morada.Cidade" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">País</label>
                                    <InputText class="form-control" @bind-Value="perfilModel.Morada.Pais" />
                                </div>
                            </div>

                            <div class="d-grid gap-2 mt-4">
                                <button type="submit" class="btn btn-primary btn-lg">
                                    <i class="bi bi-save me-2"></i>Guardar Dados Pessoais
                                </button>
                            </div>
                        </EditForm>

                        @* ======================================================================== *@
                        @* 2. SECÇÃO DE SEGURANÇA *@
                        @* ======================================================================== *@

                        <hr class="my-5 border-2" />

                        <div class="bg-light p-4 rounded-3 border">
                            <h5 class="text-danger mb-3"><i class="bi bi-shield-lock me-2"></i>Segurança</h5>
                            <p class="text-muted small">Aqui pode alterar a sua palavra-passe. Necessita da atual para confirmar a mudança.</p>

                            <div class="mb-3">
                                <label class="form-label">Password Atual</label>
                                <input type="password" class="form-control" @bind="passAtual" placeholder="Insira a password atual..." />
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">Nova Password</label>
                                    <input type="password" class="form-control" @bind="passNova" placeholder="Mínimo 6 caracteres..." />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Confirmar Nova Password</label>
                                    <input type="password" class="form-control" @bind="passConfirm" placeholder="Repita a nova password..." />
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <div>
                                    @if (!string.IsNullOrEmpty(msgPass))
                                    {
                                        <span class="@(isPassError ? "text-danger" : "text-success") fw-bold">
                                            @if (!isPassError)
                                            {
                                                <i class="bi bi-check-circle me-1"></i>
                                            }
                                            else
                                            {

                                                <i class="bi bi-exclamation-circle me-1"></i>
                                            }
                                            @msgPass
                                        </span>
                                    }
                                </div>
                                <button class="btn btn-outline-danger" @onclick="MudarPassword">
                                    Atualizar Password
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    // --- DADOS DO PERFIL ---
    private EditarPerfilModel perfilModel = new EditarPerfilModel();
    private bool isLoading = true;
    private bool loadError = false;
    private string debugErro = "";

    // Mensagens Perfil
    private string mensagemSucesso = "";
    private string mensagemErro = "";

    // --- DADOS DA PASSWORD ---
    private string passAtual = "";
    private string passNova = "";
    private string passConfirm = "";
    private string msgPass = "";
    private bool isPassError = false;

    protected override async Task OnInitializedAsync()
    {
        await CarregarDados();
    }

    private async Task CarregarDados()
    {
        isLoading = true;
        loadError = false;
        debugErro = "";

        var (dadosUser, erroCapturado) = await AuthService.ObterPerfil();

        if (dadosUser != null)
        {
            perfilModel = new EditarPerfilModel
            {
                Nome = dadosUser.Nome,
                Apelido = dadosUser.Apelido,
                NIF = dadosUser.NIF,
                Telemovel = dadosUser.Telemovel,
                Morada = new MoradaDTO
                {
                    Rua = dadosUser.Rua,
                    Localidade = dadosUser.Localidade,
                    CodigoPostal = dadosUser.CodigoPostal,
                    Cidade = dadosUser.Cidade,
                    Pais = dadosUser.Pais
                }
            };
        }
        else
        {
            loadError = true;
            debugErro = erroCapturado;
        }

        isLoading = false;
    }

    private async Task GuardarAlteracoes()
    {
        mensagemSucesso = "";
        mensagemErro = "";

        var sucesso = await AuthService.AtualizarPerfil(perfilModel);

        if (sucesso)
        {
            mensagemSucesso = "Perfil atualizado com sucesso!";
            await CarregarDados();
        }
        else
        {
            mensagemErro = "Ocorreu um erro ao atualizar os dados pessoais.";
        }
    }

    private async Task MudarPassword()
    {
        msgPass = "";
        isPassError = false;

        // 1. Validação: Campos Vazios
        if (string.IsNullOrWhiteSpace(passAtual) || string.IsNullOrWhiteSpace(passNova))
        {
            isPassError = true;
            msgPass = "Preencha a password atual e a nova.";
            return;
        }

        // 2. Validação: Confirmar
        if (passNova != passConfirm)
        {
            isPassError = true;
            msgPass = "A confirmação da password não coincide.";
            return;
        }

        // 3. NOVA VALIDAÇÃO: Igual à anterior
        if (passAtual == passNova)
        {
            isPassError = true;
            msgPass = "A nova password deve ser diferente da atual.";
            return;
        }

        // Chama o serviço
        var erroAPI = await AuthService.AlterarPassword(passAtual, passNova, passConfirm);

        if (string.IsNullOrEmpty(erroAPI))
        {
            isPassError = false;
            msgPass = "Palavra-passe alterada com sucesso!";
            passAtual = passNova = passConfirm = "";
        }
        else
        {
            isPassError = true;
            msgPass = "Erro: " + erroAPI.Trim('"');
        }
    }
}