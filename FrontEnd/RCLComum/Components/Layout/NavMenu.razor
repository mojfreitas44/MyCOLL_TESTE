@using Microsoft.AspNetCore.Components.Authorization
@using RCLAPI.Services
@inject AuthService Auth
@inject NavigationManager Nav

<nav class="navbar navbar-expand-lg navbar-dark bg-custom shadow py-3">
    <div class="container">
        <a class="navbar-brand fw-bold" href="">
            <i class="bi bi-box-seam-fill me-2"></i>MyCOLL
        </a>

        <button class="navbar-toggler" type="button" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="@NavMenuCssClass navbar-collapse justify-content-end" id="navbarNav">
            <ul class="navbar-nav align-items-center">

                <li class="nav-item">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Home</NavLink>
                </li>

                <li class="nav-item">
                    <NavLink class="nav-link" href="colecao">
                        <i class="bi bi-collection me-1"></i> A Nossa Coleção
                    </NavLink>
                </li>

                <li class="nav-item">
                    <NavLink class="nav-link" href="loja">
                        <i class="bi bi-shop me-1"></i> Loja
                    </NavLink>
                </li>

                <AuthorizeView>
                    <Authorized>
                        <li class="nav-item">
                            <NavLink class="nav-link position-relative" href="carrinho">
                                <i class="bi bi-cart-fill fs-5"></i>
                            </NavLink>
                        </li>
                    </Authorized>
                    <NotAuthorized>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="login">
                                <i class="bi bi-cart fs-5"></i>
                            </NavLink>
                        </li>
                    </NotAuthorized>
                </AuthorizeView>

                <AuthorizeView>
                    <Authorized>
                        <li class="nav-item d-none d-lg-block mx-2 text-white-50">|</li>
                        <li class="nav-item">
                            <span class="nav-link text-warning fw-bold">Olá, @context.User.Identity?.Name</span>
                        </li>
                        <li class="nav-item ms-lg-2">
                            <button class="btn btn-outline-light btn-sm rounded-pill px-3" @onclick="Logout">
                                <i class="bi bi-box-arrow-right me-1"></i> Sair
                            </button>
                        </li>
                    </Authorized>
                    <NotAuthorized>
                        <li class="nav-item ms-lg-3 mt-2 mt-lg-0">
                            <NavLink class="btn btn-light text-primary fw-bold rounded-pill px-4 shadow-sm" href="login">
                                Entrar
                            </NavLink>
                        </li>
                    </NotAuthorized>
                </AuthorizeView>

            </ul>
        </div>
    </div>
</nav>

<style>
    .bg-custom {
        background: linear-gradient(135deg, #0d6efd, #0a58ca);
    }

    .nav-link {
        font-size: 1.05rem;
        margin: 0 5px;
        transition: all 0.3s;
    }

        .nav-link:hover {
            color: #ffc107 !important; /* Amarelo ao passar o rato */
            transform: translateY(-2px);
        }

    .btn-logout:hover {
        background-color: rgba(255,255,255,0.2);
    }
</style>

@code {
    private bool collapseNavMenu = true;
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private async Task Logout()
    {
        await Auth.Logout();
        Nav.NavigateTo("/login");
    }
}