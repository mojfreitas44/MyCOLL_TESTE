@using Microsoft.AspNetCore.Components.Authorization
@using RCLAPI.Services
@inject AuthService Auth
@inject NavigationManager Nav
@inject CarrinhoService CarrinhoService
@implements IDisposable

<nav class="navbar navbar-expand-lg navbar-dark bg-custom shadow py-3">
    <div class="container">
        <a class="navbar-brand fw-bold" href="">
            <i class="bi bi-box-seam-fill me-2"></i>MyCOLL
        </a>

        <button class="navbar-toggler" type="button" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="@NavMenuCssClass navbar-collapse justify-content-end" id="navbarNav">
            <ul class="navbar-nav align-items-center">

                @* 1. HOME (Visível para todos) *@
                <li class="nav-item">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Home</NavLink>
                </li>

                @* 2. LÓGICA DE VISIBILIDADE 
                   Se for Fornecedor: Vê Ferramentas de Gestão.
                   Se NÃO for Fornecedor (Cliente/Anónimo): Vê Loja e Coleção.
                *@
                <AuthorizeView Roles="Fornecedor">
                    <Authorized>
                        @* --- APENAS FORNECEDORES --- *@
                        <li class="nav-item">
                            <NavLink class="nav-link" href="fornecedor/produtos">
                                <i class="bi bi-boxes me-1"></i> Meus Produtos
                            </NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="fornecedor/vendas">
                                <i class="bi bi-graph-up-arrow me-1"></i> Minhas Vendas
                            </NavLink>
                        </li>
                    </Authorized>
                    <NotAuthorized>
                        @* --- APENAS CLIENTES OU VISITANTES --- *@
                        <li class="nav-item">
                            <NavLink class="nav-link" href="colecao">
                                <i class="bi bi-collection me-1"></i> A Nossa Coleção
                            </NavLink>
                        </li>

                        <li class="nav-item">
                            <NavLink class="nav-link" href="loja">
                                <i class="bi bi-shop me-1"></i> Loja
                            </NavLink>
                        </li>

                        @* O Carrinho também só aparece para quem NÃO é fornecedor *@
                        <li class="nav-item me-3">
                            <NavLink class="nav-link position-relative d-flex align-items-center" href="carrinho">
                                <img src="_content/RCLImages/images/cart.png"
                                     alt="Carrinho"
                                     width="24"
                                     style="filter: invert(1) brightness(2);" />

                                @if (contagemCarrinho > 0)
                                {
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                                          style="font-size: 0.6rem; margin-top: 5px; margin-left: -10px;">
                                        @contagemCarrinho
                                    </span>
                                }
                            </NavLink>
                        </li>
                    </NotAuthorized>
                </AuthorizeView>

                @* 3. ZONA DE UTILIZADOR (Dropdown Limpa) *@
                <AuthorizeView>
                    <Authorized>
                        <li class="nav-item dropdown position-relative">
                            <a class="nav-link dropdown-toggle text-white fw-bold d-flex align-items-center"
                               href="#"
                               @onclick="ToggleUserMenu"
                               @onclick:preventDefault>
                                <i class="bi bi-person-circle me-2 fs-5"></i>
                                <span>Olá, @context.User.Identity?.Name</span>
                            </a>

                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 mt-2 @(expandirMenuUtilizador ? "show" : "")"
                                style="position: absolute; right: 0; left: auto;">

                                @* Item 1: Minha Conta (Para todos) *@
                                <li>
                                    <NavLink class="dropdown-item" href="perfil" @onclick="FecharMenus">
                                        <i class="bi bi-person me-2"></i>Perfil
                                    </NavLink>
                                </li>

                                @* --- INSERÇÃO: MEUS FAVORITOS (Apenas Cliente) --- *@
                                @if (context.User.IsInRole("Cliente"))
                                {
                                    <li>
                                        <NavLink class="dropdown-item" href="favoritos" @onclick="FecharMenus">
                                            <i class="bi bi-heart-fill me-2 text-danger"></i>Favoritos
                                        </NavLink>
                                    </li>
                                }
                                @* ------------------------------------------------ *@

                                @* Item 2: Minhas Encomendas (APENAS se for Cliente) *@
                                <AuthorizeView Roles="Cliente" Context="clienteContext">
                                    <li>
                                        <NavLink class="dropdown-item" href="encomendas" @onclick="FecharMenus">
                                            <i class="bi bi-box-seam me-2"></i>Minhas Encomendas
                                        </NavLink>
                                    </li>
                                </AuthorizeView>

                                <li><hr class="dropdown-divider"></li>

                                @* Item 3: Sair *@
                                <li>
                                    <button class="dropdown-item text-danger fw-bold" @onclick="Logout">
                                        <i class="bi bi-box-arrow-right me-2"></i>Sair
                                    </button>
                                </li>
                            </ul>
                        </li>
                    </Authorized>
                    <NotAuthorized>
                        <li class="nav-item ms-lg-3 mt-2 mt-lg-0">
                            <NavLink class="btn btn-light text-primary fw-bold rounded-pill px-4 shadow-sm" href="login">
                                Entrar
                            </NavLink>
                        </li>
                    </NotAuthorized>
                </AuthorizeView>

            </ul>
        </div>
    </div>
</nav>

<style>
    .bg-custom {
        background: linear-gradient(135deg, #0d6efd, #0a58ca);
    }

    .nav-link {
        font-size: 1.05rem;
        margin: 0 5px;
        transition: all 0.3s;
        cursor: pointer;
    }

        .nav-link:hover {
            color: #ffc107 !important;
            transform: translateY(-2px);
        }

    /* Animação suave para o menu */
    .dropdown-menu.show {
        animation: fadeIn 0.3s;
        display: block;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

@code {
    private bool collapseNavMenu = true;
    private bool expandirMenuUtilizador = false;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;
    private int contagemCarrinho = 0;

    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;
    private void ToggleUserMenu() => expandirMenuUtilizador = !expandirMenuUtilizador;

    private void FecharMenus()
    {
        expandirMenuUtilizador = false;
        collapseNavMenu = true;
    }

    protected override async Task OnInitializedAsync()
    {
        contagemCarrinho = await CarrinhoService.GetContagemTotal();
        CarrinhoService.OnChange += AtualizarContagem;
    }

    private async void AtualizarContagem()
    {
        contagemCarrinho = await CarrinhoService.GetContagemTotal();
        await InvokeAsync(StateHasChanged);
    }

    private async Task Logout()
    {
        FecharMenus();
        await CarrinhoService.LimparCarrinho();
        await Auth.Logout();
        Nav.NavigateTo("/", forceLoad: true);
    }

    public void Dispose()
    {
        CarrinhoService.OnChange -= AtualizarContagem;
    }
}