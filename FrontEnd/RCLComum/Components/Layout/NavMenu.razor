@using Microsoft.AspNetCore.Components.Authorization
@using RCLAPI.Services
@inject AuthService Auth
@inject NavigationManager Nav
@inject CarrinhoService CarrinhoService
@implements IDisposable

<nav class="navbar navbar-expand-lg navbar-dark bg-custom shadow py-3">
    <div class="container">
        <a class="navbar-brand fw-bold" href="">
            <i class="bi bi-box-seam-fill me-2"></i>MyCOLL
        </a>

        <button class="navbar-toggler" type="button" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="@NavMenuCssClass navbar-collapse justify-content-end" id="navbarNav">
            <ul class="navbar-nav align-items-center">

                <li class="nav-item">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Home</NavLink>
                </li>

                <li class="nav-item">
                    <NavLink class="nav-link" href="colecao">
                        <i class="bi bi-collection me-1"></i> A Nossa Coleção
                    </NavLink>
                </li>

                <li class="nav-item">
                    <NavLink class="nav-link" href="loja">
                        <i class="bi bi-shop me-1"></i> Loja
                    </NavLink>
                </li>

                @* --- CARRINHO --- *@
                <li class="nav-item">
                    <NavLink class="nav-link position-relative d-flex align-items-center" href="carrinho">
                        <img src="_content/RCLImages/images/cart.png"
                             alt="Carrinho"
                             width="24"
                             style="filter: invert(1) brightness(2);" />

                        @if (contagemCarrinho > 0)
                        {
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.6rem; margin-top: 5px; margin-left: -10px;">
                                @contagemCarrinho
                            </span>
                        }
                    </NavLink>
                </li>

                <AuthorizeView>
                    <Authorized>
                        @* --- SAUDAÇÃO SIMPLES (Sem Dropdown) --- *@
                        <li class="nav-item ms-lg-3 d-flex align-items-center text-white">
                            <i class="bi bi-person-circle me-2"></i>
                            <span class="fw-bold">Olá, @context.User.Identity?.Name</span>
                        </li>

                        @* --- BOTÃO SAIR --- *@
                        <li class="nav-item ms-lg-3 mt-2 mt-lg-0">
                            <button class="btn btn-outline-light rounded-pill btn-sm px-3 shadow-sm" @onclick="Logout">
                                <i class="bi bi-box-arrow-right me-1"></i> Sair
                            </button>
                        </li>
                    </Authorized>
                    <NotAuthorized>
                        <li class="nav-item ms-lg-3 mt-2 mt-lg-0">
                            <NavLink class="btn btn-light text-primary fw-bold rounded-pill px-4 shadow-sm" href="login">
                                Entrar
                            </NavLink>
                        </li>
                    </NotAuthorized>
                </AuthorizeView>

            </ul>
        </div>
    </div>
</nav>

<style>
    .bg-custom {
        background: linear-gradient(135deg, #0d6efd, #0a58ca);
    }

    .nav-link {
        font-size: 1.05rem;
        margin: 0 5px;
        transition: all 0.3s;
    }

        .nav-link:hover {
            color: #ffc107 !important;
            transform: translateY(-2px);
        }
</style>

@code {
    private bool collapseNavMenu = true;
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;
    private int contagemCarrinho = 0;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    protected override async Task OnInitializedAsync()
    {
        contagemCarrinho = await CarrinhoService.GetContagemTotal();
        CarrinhoService.OnChange += AtualizarContagem;
    }

    private async void AtualizarContagem()
    {
        contagemCarrinho = await CarrinhoService.GetContagemTotal();
        await InvokeAsync(StateHasChanged);
    }

    private async Task Logout()
    {
        await Auth.Logout();
        Nav.NavigateTo("/", forceLoad: true);
    }

    public void Dispose()
    {
        CarrinhoService.OnChange -= AtualizarContagem;
    }
}