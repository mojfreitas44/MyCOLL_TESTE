@page "/fornecedor/produtos/criar"
@page "/fornecedor/produtos/editar/{Id:int}"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using RCLAPI.DTO
@using RCLAPI.Services
@inject FornecedorService FornecedorService
@inject CategoriasCliente CategoriasService
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject PhotoPicker PhotoPicker
@attribute [Authorize(Roles = "Fornecedor")]

<div class="container mt-4 mb-5">
    <div class="card shadow border-0">
        <div class="card-header bg-primary text-white d-flex align-items-center">
            <i class="@(Id == null ? "bi bi-plus-circle" : "bi bi-pencil") me-2 fs-5"></i>
            <h4 class="mb-0">
                @(Id == null ? "Novo Produto" : "Editar Produto")
            </h4>
        </div>

        @if (Id.HasValue)
        {
            <div class="alert alert-warning m-0 rounded-0 text-center fw-bold">
                <i class="bi bi-exclamation-triangle me-2"></i>
                Atenção: Ao editar, o produto volta a ficar <span class="text-decoration-underline">Pendente</span>.
            </div>
        }

        <div class="card-body bg-light">
            @if (carregando)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                </div>
            }
            else
            {
                @* O EditForm trata de tudo. Se CategoriaId for 0, o Range falha e o OnValidSubmit NÃO corre. *@
                <EditForm Model="produto" OnValidSubmit="SalvarProduto">
                    <DataAnnotationsValidator />
                    @* Este ValidationSummary mostra a lista de erros no topo *@
                    <ValidationSummary class="alert alert-danger mb-3" />

                    <div class="row">
                        @* --- Coluna da Esquerda --- *@
                        <div class="col-md-8">

                            <div class="form-floating mb-3">
                                <InputText id="nome" class="form-control" @bind-Value="produto.Nome" placeholder="Nome" />
                                <label for="nome">Nome do Produto *</label>
                                <ValidationMessage For="@(() => produto.Nome)" class="text-danger small" />
                            </div>

                            <div class="form-floating mb-3">
                                <InputTextArea id="desc" class="form-control" @bind-Value="produto.Descricao"
                                               style="height: 120px" placeholder="Descrição" />
                                <label for="desc">Descrição Detalhada *</label>
                                <ValidationMessage For="@(() => produto.Descricao)" class="text-danger small" />
                            </div>

                            <div class="row g-2">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-bold small text-muted">Preço Base (€) *</label>
                                    <div class="input-group">
                                        <span class="input-group-text">€</span>
                                        <InputNumber class="form-control" @bind-Value="produto.PrecoVenda" />
                                    </div>
                                    <ValidationMessage For="@(() => produto.PrecoVenda)" class="text-danger small" />
                                </div>

                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-bold small text-muted">Stock (Min: @stockMinimo) *</label>
                                    <InputNumber class="form-control" @bind-Value="produto.Stock" min="@stockMinimo" />
                                    <ValidationMessage For="@(() => produto.Stock)" class="text-danger small" />

                                    @if (Id.HasValue)
                                    {
                                        <div class="form-text text-muted" style="font-size: 0.75rem">
                                            Não pode reduzir o stock atual (@stockMinimo).
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="form-text text-muted" style="font-size: 0.75rem">
                                            Stock inicial deve ser pelo menos 1.
                                        </div>
                                    }
                                </div>

                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-bold small text-muted">Condição</label>
                                    <InputSelect class="form-select" @bind-Value="produto.Condicao">
                                        <option value="Usado">Usado</option>
                                        <option value="Novo">Novo</option>
                                    </InputSelect>
                                </div>
                            </div>

                            <div class="col-md-12 mb-3">
                                <div class="d-flex justify-content-between align-items-center p-3 border rounded bg-white shadow-sm">
                                    <div style="cursor: pointer" onclick="document.getElementById('paraVenda').click()">
                                        <label class="fw-bold d-block mb-0" style="cursor: pointer;">
                                            @(produto.ParaVenda ? "Disponível para Venda (Loja)" : "Apenas para Coleção (Não Vender)")
                                        </label>
                                        <small class="text-muted">
                                            @if (produto.ParaVenda)
                                            {
                                                <span class="text-success"><i class="bi bi-cart-check me-1"></i>Visível na Loja com botão 'Comprar'</span>
                                            }
                                            else
                                            {
                                                <span class="text-secondary"><i class="bi bi-eye me-1"></i>Visível apenas em 'A Nossa Coleção'</span>
                                            }
                                        </small>
                                    </div>
                                    <div class="form-check form-switch m-0 ms-3">
                                        <InputCheckbox id="paraVenda" class="form-check-input"
                                                       style="cursor: pointer; transform: scale(1.3);"
                                                       @bind-Value="produto.ParaVenda" />
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Categoria *</label>

                                @* O InputSelect verifica o [Range] no DTO. Se for 0, fica vermelho. *@
                                <InputSelect class="form-select" @bind-Value="produto.CategoriaId">
                                    @* Valor 0 para a opção padrão, que será inválido pelo Range(1,...) *@
                                    <option value="0" selected>-- Selecione uma Categoria --</option>
                                    @foreach (var cat in categorias)
                                    {
                                        <option value="@cat.Id">@cat.Nome</option>
                                    }
                                </InputSelect>

                                @* A mensagem "A categoria é obrigatória" aparece aqui *@
                                <ValidationMessage For="@(() => produto.CategoriaId)" class="text-danger small" />
                            </div>
                        </div>

                        @* --- Coluna da Direita: Imagem --- *@
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Imagem</label>

                            <div class="card bg-light text-center p-3 mb-3">
                                @if (!string.IsNullOrEmpty(previewImagem))
                                {
                                    <div class="position-relative d-inline-block w-100">
                                        <img src="@previewImagem" class="img-fluid rounded mb-2" style="max-height: 200px; object-fit: contain;" />

                                        <button type="button" class="btn btn-danger position-absolute top-0 end-0 m-1 shadow"
                                                style="width: 30px; height: 30px; padding: 0; line-height: 1; border-radius: 4px;"
                                                @onclick="RemoverImagemSelecionada"
                                                title="Remover imagem">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-muted py-4">
                                        <i class="bi bi-image fs-1"></i>
                                        <p>Sem imagem</p>
                                    </div>
                                }

                                <div class="d-grid mt-2">
                                    <button type="button" class="btn btn-primary" @onclick="EscolherImagemNativa">
                                        <i class="bi bi-camera me-2"></i>Escolher Foto
                                    </button>
                                </div>
                            </div>

                            <small class="text-muted mt-2 text-center d-block" style="font-size: 0.7rem;">
                                JPG/PNG (Max 2MB)
                            </small>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <div class="d-flex justify-content-end gap-2">
                        <a href="fornecedor/produtos" class="btn btn-outline-secondary px-4">Cancelar</a>
                        <button type="submit" class="btn btn-primary px-4 fw-bold">
                            <i class="bi bi-save me-2"></i>Guardar Produto
                        </button>
                    </div>
                </EditForm>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public int? Id { get; set; }

    private ProdutoCreateDTO produto = new() { Condicao = "Usado", Stock = 1 };
    private List<CategoriaDTO> categorias = new();

    private string? previewImagem;
    private int stockMinimo = 1;

    private bool carregando = true;

    protected override async Task OnInitializedAsync()
    {
        carregando = true;
        try
        {
            categorias = await CategoriasService.GetCategorias() ?? new List<CategoriaDTO>();

            if (Id.HasValue)
            {
                var meusProdutos = await FornecedorService.GetMeusProdutos();
                var p = meusProdutos.FirstOrDefault(x => x.Id == Id.Value);

                if (p != null)
                {
                    stockMinimo = p.Stock;
                    produto = new ProdutoCreateDTO
                    {
                        Nome = p.Nome ?? "",
                        Descricao = p.Descricao ?? "",
                        PrecoVenda = p.PrecoVenda,
                        ParaVenda = p.ParaVenda,
                        Stock = p.Stock,
                        Condicao = string.IsNullOrEmpty(p.Condicao) ? "Usado" : p.Condicao,
                        CategoriaId = p.CategoriaId
                    };
                    if (!string.IsNullOrEmpty(p.ImagemSrc))
                    {
                        previewImagem = p.ImagemSrc;
                    }
                }
                else
                {
                    await JS.InvokeVoidAsync("alert", "Produto não encontrado.");
                    Nav.NavigateTo("fornecedor/produtos");
                }
            }
            else
            {
                stockMinimo = 1;
                produto.Stock = 1;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro: {ex.Message}");
        }
        finally
        {
            carregando = false;
        }
    }

    private async Task EscolherImagemNativa()
    {
        try
        {
            var base64 = await PhotoPicker.PickPhotoBase64Async();

            if (base64 != null)
            {
                produto.ImagemBase64 = base64;
                produto.RemoverImagem = false;
                previewImagem = $"data:image/jpeg;base64,{base64}";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", "Erro ao escolher imagem: " + ex.Message);
        }
    }

    private void RemoverImagemSelecionada()
    {
        produto.ImagemBase64 = null;
        produto.RemoverImagem = true;
        previewImagem = null;
    }

    private async Task SalvarProduto()
    {
        // REMOVIDO: A validação manual da categoria.
        // Agora confiamos no [Range] do DTO que impede este método de correr se CategoriaId for 0.

        // Validação de Stock (Regra de Negócio extra)
        if (produto.Stock < stockMinimo)
        {
            string msg = Id.HasValue
                ? $"Não pode reduzir o stock! O valor mínimo permitido é {stockMinimo}."
                : "O stock inicial tem de ser pelo menos 1.";

            await JS.InvokeVoidAsync("alert", msg);
            return;
        }

        bool sucesso;
        if (Id.HasValue)
            sucesso = await FornecedorService.EditarProduto(Id.Value, produto);
        else
            sucesso = await FornecedorService.CriarProduto(produto);

        if (sucesso)
        {
            await JS.InvokeVoidAsync("alert", "Produto guardado com sucesso!");
            Nav.NavigateTo("fornecedor/produtos");
        }
        else
        {
            await JS.InvokeVoidAsync("alert", "Erro ao guardar. Verifique os dados.");
        }
    }
}