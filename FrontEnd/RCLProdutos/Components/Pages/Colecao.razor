@page "/colecao"
@using RCLAPI.DTO
@using RCLAPI.Services
@inject ProdutosCliente ProdutosService

<PageTitle>A Nossa Coleção</PageTitle>

<div class="container mt-4">
    <h2 class="text-primary fw-bold mb-4"><i class="bi bi-collection me-2"></i>A Nossa Coleção</h2>

    @if (produtos == null)
    {
        <div class="spinner-border text-primary"></div>
    }
    else if (!produtos.Any())
    {

        <div class="alert alert-info">Ainda não existem itens na coleção pessoal.</div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var produto in produtos)
            {
                <div class="col-md-6 col-lg-4 col-xl-3">
                    <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden card-hover">
                        <div class="position-relative bg-light" style="height: 250px;">
                            @if (!string.IsNullOrEmpty(produto.ImagemSrc))
                            {
                                <img src="@produto.ImagemSrc" class="w-100 h-100 object-fit-cover" alt="@produto.Nome" />
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center h-100 text-muted"><i class="bi bi-image fs-1"></i></div>
                            }
                            <span class="position-absolute top-0 end-0 badge bg-primary text-white m-2 shadow-sm">Coleção</span>
                        </div>

                        <div class="card-body">
                            <h5 class="card-title fw-bold text-truncate">@produto.Nome</h5>
                            <p class="card-text text-muted small text-truncate">@produto.Descricao</p>
                            <span class="badge bg-light text-dark border">@produto.CategoriaNome</span>
                        </div>

                        <div class="card-footer bg-white border-top-0 pb-3">
                            <a href="produtos/detalhes/@produto.Id" class="btn btn-outline-primary w-100 rounded-pill">Ver Detalhes</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<ProdutoDTO>? produtos;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var todos = await ProdutosService.GetProdutos();
            // Filtro: Apenas o que NÃO é Para Venda
            produtos = todos.Where(p => p.ParaVenda == false).ToList();
        }
        catch { produtos = new List<ProdutoDTO>(); }
    }
}