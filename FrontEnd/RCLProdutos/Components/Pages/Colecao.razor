@page "/colecao"
@using RCLAPI.DTO
@using RCLAPI.Services
@inject ProdutosCliente ProdutosService

<PageTitle>A Nossa Coleção</PageTitle>

<div class="container mt-4">
    <div class="d-flex align-items-center mb-4">
        <h2 class="text-primary fw-bold mb-0">
            <i class="bi bi-collection me-2"></i>A Nossa Coleção
        </h2>
    </div>

    @if (produtos == null)
    {
        <div class="d-flex justify-content-center p-5">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else if (!produtos.Any())
    {
        <div class="alert alert-info rounded-3 shadow-sm">
            <i class="bi bi-info-circle me-2"></i> A nossa coleção ainda não tem itens.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var produto in produtos)
            {
                <div class="col-md-6 col-lg-4 col-xl-3">
                    <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden card-hover">

                        <div class="position-relative bg-light" style="height: 250px;">
                            @if (!string.IsNullOrEmpty(produto.ImagemSrc))
                            {
                                <img src="@produto.ImagemSrc" class="w-100 h-100 object-fit-cover" alt="@produto.Nome" />
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center h-100 text-muted">
                                    <i class="bi bi-image fs-1" style="font-size: 3rem;"></i>
                                </div>
                            }

                            <span class="position-absolute top-0 end-0 badge bg-primary text-white m-2 shadow-sm px-3 py-2 rounded-pill">
                                <i class="bi bi-star-fill me-1"></i> Acervo
                            </span>
                        </div>

                        <div class="card-body">
                            <h5 class="card-title fw-bold text-truncate">@produto.Nome</h5>

                            <p class="card-text text-muted small text-truncate mb-2">
                                @(string.IsNullOrEmpty(produto.Descricao) ? "Sem descrição" : produto.Descricao)
                            </p>

                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <span class="badge bg-light text-dark border">
                                    @produto.CategoriaNome
                                </span>

                                <small class="text-muted fw-bold" style="font-size: 0.8rem;">
                                    Status: @produto.Estado
                                </small>
                            </div>
                        </div>

                        <div class="card-footer bg-white border-top-0 pb-3 pt-0">
                            <a href="produtos/detalhes/@produto.Id" class="btn btn-outline-primary w-100 rounded-pill">
                                <i class="bi bi-eye me-2"></i>Ver Detalhes
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .card-hover {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .card-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
        }

    .object-fit-cover {
        object-fit: cover;
    }
</style>

@code {
    private List<ProdutoDTO>? produtos;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var todos = await ProdutosService.GetProdutos();

            // --- CORREÇÃO: FILTRO RELAXADO ---
            // Removemos o "&& p.Estado == 'Ativo'" para garantir que vês os produtos.
            // Filtramos APENAS por ParaVenda == false (Coleção).
            produtos = todos
                .Where(p => p.ParaVenda == false)
                .ToList();
        }
        catch
        {
            produtos = new List<ProdutoDTO>();
        }
    }
}