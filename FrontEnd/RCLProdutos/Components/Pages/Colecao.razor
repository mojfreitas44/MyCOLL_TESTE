@page "/colecao"
@using RCLAPI.DTO
@using RCLAPI.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject ProdutosCliente ProdutosService
@inject CategoriasCliente CategoriasService
@inject FavoritosService FavoritosService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

<PageTitle>A Nossa Coleção</PageTitle>

<div class="container mt-4">

    <div class="row align-items-center mb-4 g-3">
        <div class="col-md-4">
            <h2 class="text-primary fw-bold m-0"><i class="bi bi-collection me-2"></i>A Nossa Coleção</h2>
        </div>

        <div class="col-md-8">
            <div class="d-flex gap-2 justify-content-md-end">
                <select class="form-select w-auto rounded-pill border-primary text-primary fw-bold"
                        @onchange="FiltrarPorCategoria">
                    <option value="">Todas as Categorias</option>
                    @if (categorias != null)
                    {
                        @foreach (var cat in categorias)
                        {
                            <option value="@cat.Id">@cat.Nome</option>
                        }
                    }
                </select>

                <div class="input-group w-auto">
                    <input type="text" class="form-control rounded-start-pill border-end-0"
                           placeholder="Pesquisar..."
                           @bind="pesquisaTexto"
                           @bind:event="oninput"
                           @onkeyup="AtualizarPesquisa" />
                    <span class="input-group-text bg-white rounded-end-pill border-start-0 text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                </div>
            </div>
        </div>
    </div>

    @if (produtosPaginados == null)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else if (!produtosPaginados.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-folder-x text-muted display-1"></i>
            <p class="lead text-muted mt-3">Nenhum item encontrado na coleção.</p>
            <button class="btn btn-outline-primary rounded-pill mt-2" @onclick="LimparFiltros">Ver Tudo</button>
        </div>
    }
    else
    {
        <div class="row g-4 mb-5">
            @foreach (var produto in produtosPaginados)
            {
                <div class="col-md-6 col-lg-4 col-xl-3">
                    <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden card-hover position-relative">

                        <div class="position-relative bg-light" style="height: 250px;">

                            @* --- BOTÃO FAVORITOS --- *@
                            @if (!isFornecedor)
                            {
                                <button class="btn btn-light rounded-circle shadow-sm position-absolute top-0 start-0 m-2 p-0 d-flex align-items-center justify-content-center"
                                        style="z-index: 10; width: 40px; height: 40px;"
                                        @onclick="() => ToggleFavorito(produto.Id)">

                                    @if (listaIdsFavoritos.Contains(produto.Id))
                                    {
                                        <img src="_content/RCLImages/images/heartfilltransp.png" width="24" height="24" />
                                    }
                                    else
                                    {
                                        <img src="_content/RCLImages/images/heart.png" width="24" height="24" />
                                    }
                                </button>
                            }

                            @* Imagem *@
                            @if (!string.IsNullOrEmpty(produto.ImagemSrc))
                            {
                                <img src="@produto.ImagemSrc" class="w-100 h-100 object-fit-cover" alt="@produto.Nome" />
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center h-100 text-muted"><i class="bi bi-image fs-1"></i></div>
                            }

                            <span class="position-absolute top-0 end-0 badge bg-primary text-white m-2 shadow-sm">Coleção</span>
                        </div>

                        <div class="card-body">
                            <span class="badge bg-light text-dark border mb-2">@produto.CategoriaNome</span>
                            <h5 class="card-title fw-bold text-truncate">@produto.Nome</h5>
                            <p class="card-text text-muted small text-truncate">@produto.Descricao</p>
                        </div>

                        <div class="card-footer bg-white border-top-0 pb-3 pt-0">
                            <a href="/colecao/detalhes/@produto.Id" class="btn btn-outline-primary w-100 rounded-pill">Ver Detalhes</a>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (totalPaginas > 1)
        {
            <nav aria-label="Navegação">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(paginaAtual == 1 ? "disabled" : "")">
                        <button class="page-link rounded-start-pill text-primary" @onclick="() => MudarPagina(paginaAtual - 1)">Anterior</button>
                    </li>

                    @for (int i = 1; i <= totalPaginas; i++)
                    {
                        var p = i;
                        <li class="page-item @(paginaAtual == p ? "active" : "")">
                            <button class="page-link @(paginaAtual == p ? "bg-primary border-primary" : "text-primary")"
                                    @onclick="() => MudarPagina(p)">
                                @p
                            </button>
                        </li>
                    }

                    <li class="page-item @(paginaAtual == totalPaginas ? "disabled" : "")">
                        <button class="page-link rounded-end-pill text-primary" @onclick="() => MudarPagina(paginaAtual + 1)">Seguinte</button>
                    </li>
                </ul>
            </nav>
        }
    }
</div>

@code {
    private List<ProdutoDTO>? todosProdutosFiltrados;
    private List<ProdutoDTO>? produtosPaginados;
    private List<CategoriaDTO>? categorias;
    private HashSet<int> listaIdsFavoritos = new HashSet<int>();

    private string pesquisaTexto = "";
    private int? categoriaIdSelecionada = null;

    private int paginaAtual = 1;
    private int itensPorPagina = 8;
    private int totalPaginas = 1;

    private bool isFornecedor = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isFornecedor = user.IsInRole("Fornecedor");

        // --- CORREÇÃO AQUI ---
        if (user.Identity?.IsAuthenticated == true && user.IsInRole("Cliente"))
        {
            try
            {
                var favs = await FavoritosService.ObterFavoritos();
                listaIdsFavoritos = favs.Select(f => f.Id).ToHashSet();
            }
            catch { }
        }

        await CarregarDados();
    }

    private async Task CarregarDados()
    {
        try { categorias = await CategoriasService.GetCategorias(); } catch { }
        await AplicarFiltros();
    }

    private async Task ToggleFavorito(int id)
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated != true)
        {
            Nav.NavigateTo("login");
            return;
        }

        if (listaIdsFavoritos.Contains(id))
        {
            if (await FavoritosService.RemoverFavorito(id))
                listaIdsFavoritos.Remove(id);
        }
        else
        {
            if (await FavoritosService.AdicionarFavorito(id))
                listaIdsFavoritos.Add(id);
        }
    }

    private async Task AtualizarPesquisa(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || string.IsNullOrWhiteSpace(pesquisaTexto) || pesquisaTexto.Length > 2)
        {
            await AplicarFiltros();
        }
    }

    private async Task FiltrarPorCategoria(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int id))
            categoriaIdSelecionada = id;
        else
            categoriaIdSelecionada = null;

        await AplicarFiltros();
    }

    private async Task LimparFiltros()
    {
        pesquisaTexto = "";
        categoriaIdSelecionada = null;
        await AplicarFiltros();
    }

    private async Task AplicarFiltros()
    {
        paginaAtual = 1;

        var resultado = await ProdutosService.GetProdutos(pesquisaTexto, categoriaIdSelecionada);
        todosProdutosFiltrados = resultado.Where(p => p.ParaVenda == false).ToList();

        CalcularPaginacao();
    }

    private void CalcularPaginacao()
    {
        if (todosProdutosFiltrados != null)
        {
            totalPaginas = (int)Math.Ceiling((double)todosProdutosFiltrados.Count / itensPorPagina);
            produtosPaginados = todosProdutosFiltrados
                .Skip((paginaAtual - 1) * itensPorPagina)
                .Take(itensPorPagina)
                .ToList();
        }
    }

    private void MudarPagina(int novaPagina)
    {
        if (novaPagina >= 1 && novaPagina <= totalPaginas)
        {
            paginaAtual = novaPagina;
            CalcularPaginacao();
        }
    }
}