@page "/loja/detalhes/{Id:int}"
@using RCLAPI.DTO
@using RCLAPI.Services
@inject ProdutosCliente ProdutosService
@inject NavigationManager Nav

<PageTitle>@tituloPagina</PageTitle>

<div class="container mt-4">
    @* Botão Voltar para a Loja *@
    <button class="btn btn-outline-success mb-4 rounded-pill" @onclick="VoltarLoja">
        <i class="bi bi-arrow-left me-2"></i>Voltar à Loja
    </button>

    @if (isLoading)
    {
        <div class="d-flex justify-content-center align-items-center" style="height: 300px;">
            <div class="spinner-border text-success" role="status">
                <span class="visually-hidden">A carregar...</span>
            </div>
        </div>
    }
    else if (produto == null)
    {
        <div class="alert alert-warning text-center">
            <i class="bi bi-exclamation-triangle me-2"></i>Produto não encontrado.
        </div>
    }
    else
    {
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
            <div class="row g-0">
                @* Coluna da Imagem *@
                <div class="col-md-6 bg-light d-flex align-items-center justify-content-center position-relative" style="min-height: 400px;">
                    @if (!string.IsNullOrEmpty(produto.ImagemSrc))
                    {
                        <img src="@produto.ImagemSrc" class="img-fluid rounded-start object-fit-contain p-3" style="max-height: 500px;" alt="@produto.Nome">
                    }
                    else
                    {
                        <div class="text-muted text-center">
                            <i class="bi bi-bag-x" style="font-size: 5rem;"></i>
                            <p class="mt-2">Imagem indisponível</p>
                        </div>
                    }
                    <span class="position-absolute top-0 end-0 badge bg-success m-3 shadow">Venda</span>
                </div>

                @* Coluna das Informações *@
                <div class="col-md-6 bg-white">
                    <div class="card-body p-4 p-lg-5 d-flex flex-column h-100">

                        <div class="mb-2">
                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-3">
                                @produto.CategoriaNome
                            </span>
                        </div>

                        <h2 class="fw-bold mb-2">@produto.Nome</h2>

                        <div class="d-flex align-items-center mb-4">
                            <h3 class="text-success fw-bold mb-0 me-3 display-6">@produto.PrecoVenda.ToString("C")</h3>
                        </div>

                        <div class="mb-4 p-3 bg-light rounded-3 border-start border-4 border-success">
                            <div class="d-flex align-items-center mb-2">
                                <i class="bi bi-box-seam me-2 text-secondary"></i>
                                <span class="fw-bold @produto.DisponibilidadeCor">@produto.DisponibilidadeTexto</span>
                            </div>
                            <small class="text-muted d-block">
                                <strong>Fornecedor:</strong> @produto.FornecedorNome
                            </small>
                            <small class="text-muted d-block">
                                <strong>Condição:</strong> @produto.Condicao
                            </small>
                        </div>

                        <h5 class="fw-bold text-dark mb-2">Sobre o Produto</h5>
                        <p class="card-text text-secondary mb-4" style="line-height: 1.6;">
                            @(string.IsNullOrEmpty(produto.Descricao) ? "Este produto não tem descrição." : produto.Descricao)
                        </p>

                        @* Botões de Ação (Fundo da coluna) *@
                        <div class="mt-auto">
                            <div class="d-grid gap-2">
                                <button class="btn btn-success btn-lg rounded-pill shadow-sm"
                                        disabled="@(produto.Stock <= 0)"
                                        @onclick="AdicionarAoCarrinho">
                                    @if (produto.Stock <= 0)
                                    {
                                        <span><i class="bi bi-x-circle me-2"></i>Esgotado</span>
                                    }
                                    else
                                    {
                                        <span><i class="bi bi-cart-plus-fill me-2"></i>Adicionar ao Carrinho</span>
                                    }
                                </button>
                            </div>
                            @if (produto.Stock > 0 && produto.Stock <= 5)
                            {
                                <div class="text-center mt-2">
                                    <small class="text-warning fw-bold"><i class="bi bi-fire me-1"></i>Corre! Só restam @produto.Stock unidades.</small>
                                </div>
                            }
                        </div>

                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private ProdutoDTO? produto;
    private bool isLoading = true;
    private string tituloPagina = "Detalhes do Produto";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Nota: Certifica-te que adicionaste o método GetProduto(id) no Service, como falámos antes
            produto = await ProdutosService.GetProduto(Id);

            if (produto != null)
            {
                tituloPagina = produto.Nome;
                // Segurança extra: Se tentarem abrir um produto de coleção aqui, manda-os para a página certa
                if (!produto.ParaVenda)
                {
                    Nav.NavigateTo($"colecao/detalhes/{Id}");
                }
            }
        }
        catch (Exception)
        {
            // Podes adicionar um Toast de erro aqui se quiseres
        }
        finally
        {
            isLoading = false;
        }
    }

    private void VoltarLoja()
    {
        Nav.NavigateTo("loja");
    }

    private void AdicionarAoCarrinho()
    {
        // Aqui deves implementar a lógica de adicionar ao carrinho ou ir para o carrinho
        Nav.NavigateTo("carrinho");
    }
}