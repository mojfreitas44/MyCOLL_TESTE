@page "/loja/detalhes/{Id:int}"
@using RCLAPI.DTO
@using RCLAPI.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject ProdutosCliente ProdutosService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject FavoritosService FavoritosService
@inject CarrinhoService CarrinhoService

<PageTitle>@tituloPagina</PageTitle>

<div class="container mt-4">
    <button class="btn btn-outline-success mb-4 rounded-pill" @onclick="VoltarLoja">
        <i class="bi bi-arrow-left me-2"></i>Voltar à Loja
    </button>

    @if (isLoading)
    {
        <div class="d-flex justify-content-center align-items-center" style="height: 300px;">
            <div class="spinner-border text-success" role="status"></div>
        </div>
    }
    else if (produto == null)
    {
        <div class="alert alert-warning text-center">Produto não encontrado.</div>
    }
    else
    {
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
            <div class="row g-0">
                @* Coluna da Imagem *@
                <div class="col-md-6 bg-light d-flex align-items-center justify-content-center position-relative" style="min-height: 400px;">
                    @if (!string.IsNullOrEmpty(produto.ImagemSrc))
                    {
                        <img src="@produto.ImagemSrc" class="img-fluid rounded-start object-fit-contain p-3" style="max-height: 500px;" alt="@produto.Nome">
                    }
                    else
                    {
                        <div class="text-muted text-center">
                            <i class="bi bi-bag-x" style="font-size: 5rem;"></i>
                            <p class="mt-2">Imagem indisponível</p>
                        </div>
                    }
                    @* Badge apenas de Venda *@
                    <span class="position-absolute top-0 end-0 badge bg-success m-3 shadow">Venda</span>
                </div>

                @* Coluna das Informações *@
                <div class="col-md-6 bg-white">
                    <div class="card-body p-4 p-lg-5 d-flex flex-column h-100">
                        <div class="mb-2">
                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-3">
                                @produto.CategoriaNome
                            </span>
                        </div>
                        <h2 class="fw-bold mb-2">@produto.Nome</h2>

                        <div class="d-flex align-items-center mb-4">
                            <h3 class="text-success fw-bold mb-0 me-3 display-6">@produto.PrecoVenda.ToString("C")</h3>
                        </div>

                        <div class="mb-4 p-3 bg-light rounded-3 border-start border-4 border-success">
                            <div class="d-flex align-items-center mb-2">
                                <i class="bi bi-box-seam me-2 text-secondary"></i>
                                <span class="fw-bold @produto.DisponibilidadeCor">@produto.DisponibilidadeTexto</span>
                            </div>
                            <small class="text-muted d-block"><strong>Fornecedor:</strong> @produto.FornecedorNome</small>
                            <small class="text-muted d-block"><strong>Condição:</strong> @produto.Condicao</small>
                        </div>

                        <h5 class="fw-bold text-dark mb-2">Sobre o Produto</h5>
                        <p class="card-text text-secondary mb-4">@(string.IsNullOrEmpty(produto.Descricao) ? "Sem descrição." : produto.Descricao)</p>

                        <div class="mt-auto">
                            @* --- ZONA DE AÇÃO (CARRINHO + FAVORITOS) --- *@
                            <div class="d-flex align-items-center gap-3">

                                @* Botão Carrinho *@
                                <button class="btn btn-success btn-lg rounded-pill shadow-sm flex-grow-1"
                                        disabled="@(produto.Stock <= 0 || isFornecedor)"
                                        @onclick="AdicionarAoCarrinho">

                                    @if (isFornecedor)
                                    {
                                        <span><i class="bi bi-slash-circle me-2"></i>Adicionar ao Carrinho</span>
                                    }
                                    else if (produto.Stock <= 0)
                                    {
                                        <span>Esgotado</span>
                                    }
                                    else
                                    {
                                        <span><i class="bi bi-cart-plus-fill me-2"></i>Adicionar ao Carrinho</span>
                                    }
                                </button>

                                @* --- BOTÃO FAVORITO GRANDE --- *@
                                @if (!isFornecedor)
                                {
                                    <button class="btn btn-light rounded-circle shadow-sm p-0 d-flex align-items-center justify-content-center"
                                            style="width: 54px; height: 54px; border: 1px solid #e0e0e0;"
                                            title="@(isFavorito ? "Remover dos favoritos" : "Adicionar aos favoritos")"
                                            @onclick="ToggleFavorito">

                                        @if (isFavorito)
                                        {
                                            <img src="_content/RCLImages/images/heartfilltransp.png" width="30" height="30" />
                                        }
                                        else
                                        {
                                            <img src="_content/RCLImages/images/heart.png" width="30" height="30" />
                                        }
                                    </button>
                                }
                            </div>

                            @if (produto.Stock > 0 && produto.Stock <= 5)
                            {
                                <div class="text-center mt-2"><small class="text-warning fw-bold">Corre! Só restam @produto.Stock unidades.</small></div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private ProdutoDTO? produto;
    private bool isLoading = true;
    private string tituloPagina = "Detalhes do Produto";

    private bool isFornecedor = false;
    private bool isFavorito = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isFornecedor = user.IsInRole("Fornecedor");

        try
        {
            produto = await ProdutosService.GetProduto(Id);
            if (produto != null)
            {
                tituloPagina = produto.Nome;

                // Se for cliente logado, verifica favorito
                if (user.Identity?.IsAuthenticated == true && user.IsInRole("Cliente"))
                {
                    try
                    {
                        var favs = await FavoritosService.ObterFavoritos();
                        isFavorito = favs.Any(f => f.Id == Id);
                    }
                    catch { }
                }
            }
        }
        catch { }
        finally { isLoading = false; }
    }

    private async Task ToggleFavorito()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        // Redirecionar Anónimos
        if (user.Identity?.IsAuthenticated != true)
        {
            Nav.NavigateTo("login");
            return;
        }

        // Adicionar ou Remover Favorito
        if (isFavorito)
        {
            if (await FavoritosService.RemoverFavorito(Id)) isFavorito = false;
        }
        else
        {
            if (await FavoritosService.AdicionarFavorito(Id)) isFavorito = true;
        }
    }

    private async Task AdicionarAoCarrinho()
    {
        if (produto != null)
        {
            await CarrinhoService.AdicionarAoCarrinho(produto);
            //Nav.NavigateTo("carrinho"); // Opcional 
        }
    }
     private void VoltarLoja() { Nav.NavigateTo("loja"); }
}