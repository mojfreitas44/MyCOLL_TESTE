@page "/loja"
@using RCLAPI.DTO
@using RCLAPI.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject ProdutosCliente ProdutosService
@inject CategoriasCliente CategoriasService
@inject NavigationManager Nav
@inject CarrinhoService CarrinhoService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Loja Online</PageTitle>

<div class="container mt-4">

    @* --- CABEÇALHO E FILTROS --- *@
    <div class="row align-items-center mb-4 g-3">
        <div class="col-md-4">
            <h2 class="text-success fw-bold m-0"><i class="bi bi-shop me-2"></i>Loja</h2>
        </div>

        <div class="col-md-8">
            <div class="d-flex gap-2 justify-content-md-end">
                @* Dropdown Categorias *@
                <select class="form-select w-auto rounded-pill border-success text-success fw-bold"
                        @onchange="FiltrarPorCategoria">
                    <option value="">Todas as Categorias</option>
                    @if (categorias != null)
                    {
                        @foreach (var cat in categorias)
                        {
                            <option value="@cat.Id">@cat.Nome</option>
                        }
                    }
                </select>

                @* Barra de Pesquisa *@
                <div class="input-group w-auto">
                    <input type="text" class="form-control rounded-start-pill border-end-0"
                           placeholder="Pesquisar..."
                           @bind="pesquisaTexto"
                           @bind:event="oninput"
                           @onkeyup="AtualizarPesquisa" />
                    <span class="input-group-text bg-white rounded-end-pill border-start-0 text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                </div>
            </div>
        </div>
    </div>

    @* --- LISTA DE PRODUTOS --- *@
    @if (produtosPaginados == null)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border text-success" role="status"></div>
        </div>
    }
    else if (!produtosPaginados.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-search text-muted display-1"></i>
            <p class="lead text-muted mt-3">Não encontramos produtos com esses filtros.</p>
            <button class="btn btn-outline-success rounded-pill mt-2" @onclick="LimparFiltros">Limpar Filtros</button>
        </div>
    }
    else
    {
        <div class="row g-4 mb-5">
            @foreach (var produto in produtosPaginados)
            {
                <div class="col-md-6 col-lg-4 col-xl-3">
                    <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden card-hover">
                        <div class="position-relative bg-light" style="height: 250px;">
                            @if (!string.IsNullOrEmpty(produto.ImagemSrc))
                            {
                                <img src="@produto.ImagemSrc" class="w-100 h-100 object-fit-cover" alt="@produto.Nome" />
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center h-100 text-muted"><i class="bi bi-bag fs-1"></i></div>
                            }
                            <span class="position-absolute top-0 end-0 badge bg-success m-2 shadow-sm">Venda</span>
                        </div>

                        <div class="card-body">
                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill mb-2">@produto.CategoriaNome</span>
                            <h5 class="card-title fw-bold text-truncate">@produto.Nome</h5>
                            <h4 class="text-success fw-bold mb-1">@produto.PrecoVenda.ToString("C")</h4>
                            <p class="small fw-bold mb-0 @produto.DisponibilidadeCor">@produto.DisponibilidadeTexto</p>
                        </div>

                        <div class="card-footer bg-white border-top-0 pb-3 pt-0 d-grid gap-2">
                            <a href="/loja/detalhes/@produto.Id" class="btn btn-outline-secondary rounded-pill btn-sm">Ver Detalhes</a>
                            <button class="btn btn-success rounded-pill btn-sm"
                                    @onclick="() => AdicionarAoCarrinho(produto)"
                                    disabled="@(produto.Stock <= 0 || isFornecedor)">
                                <i class="bi bi-cart-plus me-1"></i> Adicionar ao Carrinho
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* --- PAGINAÇÃO --- *@
        @if (totalPaginas > 1)
        {
            <nav aria-label="Navegação">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(paginaAtual == 1 ? "disabled" : "")">
                        <button class="page-link rounded-start-pill text-success" @onclick="() => MudarPagina(paginaAtual - 1)">Anterior</button>
                    </li>

                    @for (int i = 1; i <= totalPaginas; i++)
                    {
                        var p = i; // Copiar variável para a lambda
                                   <li class="page-item @(paginaAtual == p ? "active" : "")">
                                       <button class="page-link @(paginaAtual == p ? "bg-success border-success" : "text-success")"
                                               @onclick="() => MudarPagina(p)">
                                           @p
                                       </button>
                                   </li>
                    }

                    <li class="page-item @(paginaAtual == totalPaginas ? "disabled" : "")">
                        <button class="page-link rounded-end-pill text-success" @onclick="() => MudarPagina(paginaAtual + 1)">Seguinte</button>
                    </li>
                </ul>
            </nav>
        }
    }
</div>

@code {
    // Dados
    private List<ProdutoDTO>? todosProdutosFiltrados; // Lista completa vinda da API (já filtrada por texto/cat)
    private List<ProdutoDTO>? produtosPaginados;      // Lista reduzida para a página atual
    private List<CategoriaDTO>? categorias;

    // Filtros
    private string pesquisaTexto = "";
    private int? categoriaIdSelecionada = null;

    // Paginação
    private int paginaAtual = 1;
    private int itensPorPagina = 8; // Default 8
    private int totalPaginas = 1;

    private bool isFornecedor = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        isFornecedor = authState.User.IsInRole("Fornecedor");

        await CarregarDados();
    }

    private async Task CarregarDados()
    {
        // 1. Carregar Categorias para o filtro
        try { categorias = await CategoriasService.GetCategorias(); } catch { }

        // 2. Carregar Produtos iniciais
        await AplicarFiltros();
    }

    private async Task AtualizarPesquisa(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || string.IsNullOrWhiteSpace(pesquisaTexto) || pesquisaTexto.Length > 2)
        {
            await AplicarFiltros();
        }
    }

    private async Task FiltrarPorCategoria(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int id))
            categoriaIdSelecionada = id;
        else
            categoriaIdSelecionada = null;

        await AplicarFiltros();
    }

    private async Task LimparFiltros()
    {
        pesquisaTexto = "";
        categoriaIdSelecionada = null;
        await AplicarFiltros();
    }

    private async Task AplicarFiltros()
    {
        // Reinicia a paginação
        paginaAtual = 1;

        // Vai à API buscar produtos com os filtros de Texto e Categoria
        // Nota: A API devolve tudo o que corresponde ao filtro. A paginação visual fazemos aqui no cliente.
        // Se a base de dados fosse gigante, faríamos paginação no servidor (Skip/Take na API).
        var resultado = await ProdutosService.GetProdutos(pesquisaTexto, categoriaIdSelecionada);

        // Aplica o filtro de "ParaVenda" aqui, pois a API pode devolver coleção também se não filtrarmos lá
        todosProdutosFiltrados = resultado.Where(p => p.ParaVenda == true).ToList();

        CalcularPaginacao();
    }
    private async Task AdicionarAoCarrinho(ProdutoDTO produto)
    {
        await CarrinhoService.AdicionarAoCarrinho(produto);
        // Opcional: Aqui podias adicionar um Toast/Aviso visual "Adicionado!"
    }

    private void CalcularPaginacao()
    {
        if (todosProdutosFiltrados != null)
        {
            totalPaginas = (int)Math.Ceiling((double)todosProdutosFiltrados.Count / itensPorPagina);
            produtosPaginados = todosProdutosFiltrados
                .Skip((paginaAtual - 1) * itensPorPagina)
                .Take(itensPorPagina)
                .ToList();
        }
    }

    private void MudarPagina(int novaPagina)
    {
        if (novaPagina >= 1 && novaPagina <= totalPaginas)
        {
            paginaAtual = novaPagina;
            CalcularPaginacao();
            // Scroll para o topo (opcional)
        }
    }

    private void IrParaCarrinho() { Nav.NavigateTo("carrinho"); }
}