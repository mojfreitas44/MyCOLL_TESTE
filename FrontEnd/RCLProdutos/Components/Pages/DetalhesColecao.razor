@page "/colecao/detalhes/{Id:int}"
@using RCLAPI.DTO
@using RCLAPI.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject ProdutosCliente ProdutosService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject FavoritosService FavoritosService

<PageTitle>@tituloPagina</PageTitle>

<div class="container mt-4">
    <button class="btn btn-outline-primary mb-4 rounded-pill" @onclick="VoltarColecao">
        <i class="bi bi-arrow-left me-2"></i>Voltar à Coleção
    </button>

    @if (isLoading)
    {
        <div class="d-flex justify-content-center align-items-center" style="height: 300px;">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else if (produto == null)
    {
        <div class="alert alert-info">Produto não encontrado na coleção.</div>
    }
    else
    {
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
            <div class="row g-0">
                @* Coluna da Imagem *@
                <div class="col-md-6 bg-light d-flex align-items-center justify-content-center position-relative" style="min-height: 400px;">

                    @* --- BOTÃO FAVORITOS (Canto Esquerdo) --- *@
                    @if (!isFornecedor)
                    {
                        <button class="btn btn-light rounded-circle shadow-sm position-absolute top-0 start-0 m-3 p-0 d-flex align-items-center justify-content-center"
                                style="z-index: 10; width: 50px; height: 50px;"
                                title="@(isFavorito ? "Remover dos favoritos" : "Adicionar aos favoritos")"
                                @onclick="ToggleFavorito">

                            @if (isFavorito)
                            {
                                <img src="_content/RCLImages/images/heartfilltransp.png" width="30" height="30" />
                            }
                            else
                            {
                                <img src="_content/RCLImages/images/heart.png" width="30" height="30" />
                            }
                        </button>
                    }

                    @if (!string.IsNullOrEmpty(produto.ImagemSrc))
                    {
                        <img src="@produto.ImagemSrc" class="img-fluid object-fit-contain p-3" style="max-height: 500px;" />
                    }
                    else
                    {
                        <div class="text-muted text-center">
                            <i class="bi bi-image" style="font-size: 5rem;"></i>
                            <p class="mt-2">Imagem indisponível</p>
                        </div>
                    }
                    @* Badge Coleção (Canto Direito) *@
                    <span class="position-absolute top-0 end-0 badge bg-primary m-3">Coleção</span>
                </div>

                @* Coluna dos Detalhes *@
                <div class="col-md-6">
                    <div class="card-body p-4">
                        <span class="badge bg-light text-dark border mb-2">@produto.CategoriaNome</span>
                        <h2 class="fw-bold mb-3">@produto.Nome</h2>

                        <div class="alert alert-light border-start border-primary border-4">
                            <i class="bi bi-info-circle-fill text-primary me-2"></i>
                            Este item pertence à coleção pessoal e não está à venda.
                        </div>

                        <h5 class="fw-bold mt-4">Descrição</h5>
                        <p class="text-muted">@(produto.Descricao ?? "Sem descrição.")</p>

                        <div class="mt-4">
                            <small class="d-block text-muted"><strong>Condição:</strong> @produto.Condicao</small>
                            <small class="d-block text-muted"><strong>Origem:</strong> @produto.FornecedorNome</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private ProdutoDTO? produto;
    private bool isLoading = true;
    private string tituloPagina = "Detalhes da Coleção";

    private bool isFornecedor = false;
    private bool isFavorito = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isFornecedor = user.IsInRole("Fornecedor");

        try
        {
            produto = await ProdutosService.GetProduto(Id);
            if (produto != null)
            {
                tituloPagina = produto.Nome;

                // Redirecionamento de segurança: Se for Venda, manda para a Loja
                if (produto.ParaVenda)
                {
                    Nav.NavigateTo($"/loja/detalhes/{Id}");
                }

                // Se for cliente logado, carrega estado favorito
                if (user.Identity?.IsAuthenticated == true && user.IsInRole("Cliente"))
                {
                    try
                    {
                        var favs = await FavoritosService.ObterFavoritos();
                        isFavorito = favs.Any(f => f.Id == Id);
                    }
                    catch { }
                }
            }
        }
        catch { }
        finally { isLoading = false; }
    }

    private async Task ToggleFavorito()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        // Redirecionar Anónimos
        if (user.Identity?.IsAuthenticated != true)
        {
            Nav.NavigateTo("login");
            return;
        }

        // Somente Clientes podem favoritar
        if (isFavorito)
        {
            if (await FavoritosService.RemoverFavorito(Id)) isFavorito = false;
        }
        else
        {
            if (await FavoritosService.AdicionarFavorito(Id)) isFavorito = true;
        }
    }

    private void VoltarColecao() => Nav.NavigateTo("colecao");
}